<mxfile host="app.diagrams.net" modified="2026-09-07T16:03:00.000Z" agent="ChatGPT"><diagram id="ncc-ra-ha" name="HA Failover"><mxGraphModel dx="1680" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Router Appliance High Availability — ECMP, MED, and BGP Withdrawal" style="text;html=1;align=center;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="15" width="1080" height="45" as="geometry"/></mxCell>
<mxCell id="region" value="us-central1 — recommended multi-zone firewall pair" style="rounded=1;html=1;whiteSpace=wrap;verticalAlign=top;spacingTop=15;spacingLeft=20;fontSize=20;fontStyle=1;fillColor=#f8f9fa;strokeColor=#5f6368;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="1580" height="735" as="geometry"/></mxCell>
<mxCell id="routes" value="&lt;b&gt;VPC workload route table&lt;/b&gt;&lt;br&gt;&lt;br&gt;10.20.20.0/24 → fw-ra-1&lt;br&gt;10.20.20.0/24 → fw-ra-2&lt;br&gt;&lt;font color='#188038'&gt;same AS path + MED ⇒ ECMP&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;spacingLeft=20;fontSize=15;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="90" y="190" width="340" height="160" as="geometry"/></mxCell>
<mxCell id="cr" value="&lt;b&gt;Cloud Router&lt;/b&gt;&lt;br&gt;&lt;br&gt;2 redundant interfaces&lt;br&gt;BGP peers to both NVAs&lt;br&gt;best path: AS path, then MED&lt;br&gt;control plane only" style="rounded=1;html=1;whiteSpace=wrap;align=center;fontSize=15;fillColor=#fff7e0;strokeColor=#f9ab00;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="555" y="170" width="250" height="210" as="geometry"/></mxCell>
<mxCell id="zone1" value="Zone us-central1-a" style="rounded=1;html=1;whiteSpace=wrap;verticalAlign=top;spacingTop=15;align=center;fontSize=20;fontStyle=1;fillColor=#e6f4ea;strokeColor=#188038;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="930" y="120" width="300" height="280" as="geometry"/></mxCell>
<mxCell id="fw1" value="&lt;b&gt;fw-ra-1&lt;/b&gt;&lt;br&gt;&lt;br&gt;ASN 65001&lt;br&gt;advertise 10.20.20.0/24&lt;br&gt;MED 100" style="rounded=1;html=1;whiteSpace=wrap;align=center;fontSize=15;fillColor=#fce8e6;strokeColor=#d93025;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="970" y="195" width="220" height="150" as="geometry"/></mxCell>
<mxCell id="zone2" value="Zone us-central1-b" style="rounded=1;html=1;whiteSpace=wrap;verticalAlign=top;spacingTop=15;align=center;fontSize=20;fontStyle=1;fillColor=#e6f4ea;strokeColor=#188038;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="1290" y="120" width="300" height="280" as="geometry"/></mxCell>
<mxCell id="fw2" value="&lt;b&gt;fw-ra-2&lt;/b&gt;&lt;br&gt;&lt;br&gt;ASN 65002&lt;br&gt;advertise 10.20.20.0/24&lt;br&gt;MED 100" style="rounded=1;html=1;whiteSpace=wrap;align=center;fontSize=15;fillColor=#fce8e6;strokeColor=#d93025;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1330" y="195" width="220" height="150" as="geometry"/></mxCell>
<mxCell id="normal" value="&lt;b&gt;Normal state — active/active ECMP&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Both appliances advertise the same prefix.&lt;br&gt;2. If AS-path and MED are equivalent, Google Cloud can install both next hops.&lt;br&gt;3. New flows are ECMP-distributed across fw-ra-1 and fw-ra-2.&lt;br&gt;4. Stateful firewalls require a vendor-supported HA/state strategy if sessions can move.&lt;br&gt;5. Do not assume ECMP alone synchronizes firewall sessions.&lt;br&gt;&lt;br&gt;&lt;font color='#188038'&gt;Alternative: unequal MED/AS-path can make one appliance preferred and one standby.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;spacingLeft=20;fontSize=16;fillColor=#ffffff;strokeColor=#5f6368;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="90" y="460" width="700" height="290" as="geometry"/></mxCell>
<mxCell id="failure" value="&lt;b&gt;Failure state — fw-ra-1 loses BGP/VM reachability&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. BGP session to fw-ra-1 goes down or next hop becomes inaccessible.&lt;br&gt;2. Cloud Router withdraws the dynamic path through fw-ra-1.&lt;br&gt;3. VPC route state converges to remaining path through fw-ra-2.&lt;br&gt;4. New packets use fw-ra-2; existing stateful sessions can reset unless synchronized.&lt;br&gt;5. If both paths disappear, the dynamic prefix is removed and traffic fails.&lt;br&gt;&lt;br&gt;&lt;font color='#d93025'&gt;BGP convergence is not a substitute for application/session-level HA design.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;spacingLeft=20;fontSize=16;fillColor=#ffffff;strokeColor=#5f6368;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="860" y="460" width="700" height="290" as="geometry"/></mxCell>
<mxCell id="routeupdate" value="route install/update" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#188038;strokeWidth=5;endArrow=block;endFill=1;fontColor=#188038;fontSize=14;" edge="1" parent="1" source="cr" target="routes"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="bgp1" value="BGP" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a73e8;strokeWidth=4;dashed=1;dashPattern=10 6;endArrow=block;endFill=1;fontColor=#1a73e8;fontSize=14;" edge="1" parent="1" source="cr" target="fw1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="bgp2" value="BGP" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a73e8;strokeWidth=4;dashed=1;dashPattern=10 6;endArrow=block;endFill=1;fontColor=#1a73e8;fontSize=14;" edge="1" parent="1" source="cr" target="fw2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="fail" value="failure / withdrawal" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d93025;strokeWidth=5;dashed=1;dashPattern=10 7;endArrow=block;endFill=1;fontColor=#d93025;fontSize=14;" edge="1" parent="1" source="fw1" target="failure"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="remain" value="remaining next hop" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#188038;strokeWidth=5;endArrow=block;endFill=1;fontColor=#188038;fontSize=14;" edge="1" parent="1" source="fw2" target="failure"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="note" value="&lt;b&gt;Design rule:&lt;/b&gt; place at least two router appliance VMs in different zones for VM-level availability; advertise identical prefixes for ECMP or deliberately manipulate path attributes for active/standby.&lt;br&gt;For a stateful NGFW, validate vendor HA/session synchronization behavior and return-path symmetry before enabling active/active traffic distribution." style="text;html=1;whiteSpace=wrap;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry x="90" y="865" width="1500" height="70" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>