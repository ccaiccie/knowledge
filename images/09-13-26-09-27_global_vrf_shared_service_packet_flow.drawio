<mxfile host="app.diagrams.net"><diagram name="Example 1: VRF 103 Reaches a Shared Service in the Global VRF"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b0" value="&lt;b&gt;Branch LAN — VRF 103&lt;/b&gt;&lt;br&gt;Host 10.10.10.10&lt;br&gt;Gateway 10.10.10.1&lt;br&gt;VRF route: 10.50.50.0/24 +" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="55" y="205" width="250" height="155" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;IOS XE Edge Router&lt;/b&gt;&lt;br&gt;VRF 103 RIB ↔ Global RIB&lt;br&gt;Leak global connected route → VRF&lt;br&gt;Leak VRF connected route → global&lt;br&gt;No NAT in this example" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="445" y="140" width="310" height="285" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;Shared DNS — Global VRF&lt;/b&gt;&lt;br&gt;Server 10.50.50.53&lt;br&gt;Subnet 10.50.50.0/24&lt;br&gt;Global route: 10.10.10.0/24 +" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="900" y="205" width="250" height="155" as="geometry"/></mxCell><mxCell id="e0" value="1  DNS query 10.10.10.10 → 10.50.50.53:53" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=4;endArrow=block;endFill=1;fontStyle=1;fontSize=13;" edge="1" parent="1" source="b0" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="2  Global RIB forwards to shared service" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=4;endArrow=block;endFill=1;fontStyle=1;fontSize=13;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="3  Reply 10.50.50.53 → 10.10.10.10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=4;endArrow=block;endFill=1;fontStyle=1;fontSize=13;" edge="1" parent="1" source="b2" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="4  Global RIB uses leaked 10.10.10.0/24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=4;endArrow=block;endFill=1;fontStyle=1;fontSize=13;" edge="1" parent="1" source="b1" target="b0"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>