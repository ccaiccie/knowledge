<mxfile host="app.diagrams.net" modified="2026-09-06T22:23:00.000Z" agent="ChatGPT"><diagram id="ns" name="Internet North-South"><mxGraphModel dx="1900" dy="1280" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageWidth="1900" pageHeight="1280"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="North-South / South-North — Distributed GWLBE for Internet Ingress and Egress" style="text;html=1;fontSize=28;fontStyle=1;align=left" vertex="1" parent="1"><mxGeometry x="35" y="15" width="1500" height="45" as="geometry"/></mxCell><mxCell id="ing" value="Internet ingress (North → South) — public ALB/NLB or public-IP workload" style="swimlane;html=1;rounded=1;startSize=40;strokeColor=#f59e0b;strokeWidth=3;fillColor=#fff7ed;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="25" y="80" width="860" height="1110" as="geometry"/></mxCell><mxCell id="inet" value="Internet&#xa;Client 198.51.100.25" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15" vertex="1" parent="1"><mxGeometry x="60" y="150" width="180" height="80" as="geometry"/></mxCell><mxCell id="igw" value="IGW igw-A&#xa;Edge-associated RT-IGW-A" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15" vertex="1" parent="1"><mxGeometry x="300" y="150" width="220" height="80" as="geometry"/></mxCell><mxCell id="gwi" value="GWLBE-A-a&#xa;Subnet 10.10.100.0/28" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#dc2626;strokeWidth=2;fillColor=#fef2f2;fontSize=15" vertex="1" parent="1"><mxGeometry x="585" y="150" width="245" height="80" as="geometry"/></mxCell><mxCell id="elb" value="Public ALB/NLB&#xa;Public subnet 10.10.30.0/24&#xa;Backend example 10.10.10.10" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15" vertex="1" parent="1"><mxGeometry x="585" y="285" width="245" height="90" as="geometry"/></mxCell><mxCell id="rti" value="Ingress route tables&#xa;&#xa;RT-IGW-A (edge association)&#xa;10.10.30.0/24 → vpce-gwlb-A-a # steer public-subnet destination to inspection&#xa;&#xa;RT-A-GWLBE-a&#xa;10.10.0.0/16 → local # after inspection, VPC router reaches ALB/NLB&#xa;&#xa;RT-A-Public-a (ALB/NLB subnet)&#xa;0.0.0.0/0 → vpce-gwlb-A-a # return path is re-inspected&#xa;&#xa;RT-A-GWLBE-a return&#xa;0.0.0.0/0 → igw-A" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=14;fontFamily=Courier New;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="60" y="420" width="770" height="285" as="geometry"/></mxCell><mxCell id="pi" value="Ingress packet transformation&#xa;&#xa;Before inspection: 198.51.100.25:53000 → public-service-address:443&#xa;GWLBE is transparent; GWLB carries original IP packet to central firewall fleet.&#xa;GENEVE exists only GWLB ↔ NGFW. Firewall sees original client/server tuple.&#xa;If destination is ALB, ALB later terminates TCP/TLS and creates a new backend connection.&#xa;If destination is NLB with client-IP preservation, backend behavior follows NLB target settings.&#xa;Critical symmetry rule: public-facing subnet return default must point back to GWLBE." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=15;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="60" y="760" width="770" height="330" as="geometry"/></mxCell><mxCell id="eg" value="Internet egress (South → North) — private workload through GWLBE + NAT Gateway" style="swimlane;html=1;rounded=1;startSize=40;strokeColor=#f59e0b;strokeWidth=3;fillColor=#fff7ed;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="930" y="80" width="945" height="1110" as="geometry"/></mxCell><mxCell id="ec2" value="EC2-A&#xa;10.10.10.10 private workload" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15" vertex="1" parent="1"><mxGeometry x="970" y="150" width="220" height="80" as="geometry"/></mxCell><mxCell id="gwe" value="GWLBE-A-a&#xa;10.10.100.0/28" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#dc2626;strokeWidth=2;fillColor=#fef2f2;fontSize=15" vertex="1" parent="1"><mxGeometry x="1250" y="150" width="220" height="80" as="geometry"/></mxCell><mxCell id="nat" value="NAT Gateway nat-a&#xa;Public subnet 10.10.40.0/24" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15" vertex="1" parent="1"><mxGeometry x="1530" y="150" width="220" height="80" as="geometry"/></mxCell><mxCell id="igwo" value="IGW → Internet&#xa;SNAT EIP 203.0.113.10" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15" vertex="1" parent="1"><mxGeometry x="1530" y="285" width="220" height="80" as="geometry"/></mxCell><mxCell id="rte" value="Egress route tables&#xa;&#xa;RT-A-App-a (10.10.10.0/24)&#xa;0.0.0.0/0 → vpce-gwlb-A-a&#xa;&#xa;RT-A-GWLBE-a (10.10.100.0/28)&#xa;0.0.0.0/0 → nat-a&#xa;&#xa;RT-A-NAT-a (10.10.40.0/24)&#xa;0.0.0.0/0 → igw-A&#xa;10.10.10.0/24 → vpce-gwlb-A-a # force return from NAT toward workload through inspection&#xa;&#xa;RT-A-GWLBE-a return&#xa;10.10.10.0/24 → local" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=14;fontFamily=Courier New;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="970" y="420" width="780" height="330" as="geometry"/></mxCell><mxCell id="pe" value="Egress packet transformation&#xa;&#xa;1. Workload emits 10.10.10.10:49152 → 1.1.1.1:443.&#xa;2. NGFW inspects private source before NAT.&#xa;3. NAT Gateway SNAT: 10.10.10.10:49152 → 203.0.113.10:mapped-port.&#xa;4. Internet return arrives to NAT Gateway, which reverses NAT to 10.10.10.10.&#xa;5. NAT-subnet route for 10.10.10.0/24 points to GWLBE, preserving firewall symmetry.&#xa;6. Endpoint local route delivers allowed packet to EC2-A." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=15;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="970" y="805" width="780" height="285" as="geometry"/></mxCell><mxCell id="svc" value="Central Security VPC&#xa;All GWLBE paths → PrivateLink → GWLB → GENEVE/6081 → NGFW fleet&#xa;The firewall fleet is shared; insertion points are per-VPC." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#dc2626;strokeWidth=2;fillColor=#fef2f2;fontSize=15" vertex="1" parent="1"><mxGeometry x="760" y="1120" width="400" height="95" as="geometry"/></mxCell><mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="inet" target="igw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="igw" target="gwi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="gwi" target="elb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="ec2" target="gwe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="gwe" target="nat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="nat" target="igwo"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>