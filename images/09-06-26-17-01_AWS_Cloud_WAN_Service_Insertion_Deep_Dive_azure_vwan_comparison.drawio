<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1100"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;AWS Cloud WAN&lt;/b&gt;&lt;br/&gt;Managed global WAN fabric&lt;br/&gt;CNE (Core Network Edge) = managed regional routing edge&lt;br/&gt;Segment = logical routing domain&lt;br/&gt;NFG (Network Function Group) = service-insertion target&lt;br/&gt;send-via = attachment-to-attachment inspection&lt;br/&gt;send-to = traffic leaves Cloud WAN after inspection&lt;br/&gt;Inspection commonly lives in separate Inspection VPC&lt;br/&gt;AWS Network Firewall or GWLBE/GWLB + NGFW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="125" width="715" height="700" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;Azure Virtual WAN (vWAN)&lt;/b&gt;&lt;br/&gt;Managed WAN fabric with regional virtual hubs&lt;br/&gt;Virtual hub router = managed routing function&lt;br/&gt;Hub route tables = routing/propagation domains&lt;br/&gt;Routing Intent = declarative security steering&lt;br/&gt;Private Traffic policy = private/branch inspection&lt;br/&gt;Internet Traffic policy = Internet-bound inspection&lt;br/&gt;Azure Firewall / supported NGFW integrated with hub&lt;br/&gt;ExpressRoute / VPN / VNet connections attach to hub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#2563eb;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="930" y="125" width="715" height="700" as="geometry"/></mxCell><mxCell id="4" value="CNE ~ virtual hub router" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7c3aed;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5" value="NFG/send-via ~ Routing Intent private policy" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7c3aed;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="6" value="send-to ~ Internet Traffic routing policy" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7c3aed;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="7" value="DX/VPN ~ ExpressRoute/VPN" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7c3aed;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>