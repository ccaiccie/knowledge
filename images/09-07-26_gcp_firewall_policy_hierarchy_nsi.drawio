<mxfile host="app.diagrams.net"><diagram name="GCP Firewall Policy Hierarchy + NSI"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1100"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="GCP Firewall Policy Hierarchy, goto_next, and NSI Invocation" style="text;html=1;fontSize=28;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="org" value="Organization&#xa;Hierarchical firewall policy association" style="rounded=1;whiteSpace=wrap;html=1;fontSize=19;fillColor=#eef2ff;strokeColor=#4f46e5;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="300" height="100" as="geometry"/></mxCell><mxCell id="folder1" value="Top-level Folder&#xa;Optional hierarchical policy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#eef2ff;strokeColor=#4f46e5;" vertex="1" parent="1"><mxGeometry x="80" y="270" width="300" height="100" as="geometry"/></mxCell><mxCell id="folder2" value="Child Folder&#xa;Optional hierarchical policy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#eef2ff;strokeColor=#4f46e5;" vertex="1" parent="1"><mxGeometry x="80" y="420" width="300" height="100" as="geometry"/></mxCell><mxCell id="project" value="Project&#xa;Contains the VPC&#xa;No hierarchical policy attaches directly here" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#f8fafc;strokeColor=#475569;" vertex="1" parent="1"><mxGeometry x="80" y="570" width="300" height="115" as="geometry"/></mxCell><mxCell id="vpc" value="VPC network&#xa;Global network firewall policy association&#xa;Regional policy association(s) by region&#xa;Classic VPC firewall rules" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#ecfeff;strokeColor=#0891b2;" vertex="1" parent="1"><mxGeometry x="80" y="735" width="300" height="145" as="geometry"/></mxCell><mxCell id="eval" value="NEW CONNECTION&#xa;&#xa;1. Org hierarchical policy&#xa;2. Folder policies top-down&#xa;3. Regional system policy&#xa;4/5. Global + regional network policy or classic VPC rules, depending on BEFORE/AFTER_CLASSIC_FIREWALL&#xa;6. Implied action" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#fff7ed;strokeColor=#ea580c;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="500" y="120" width="520" height="300" as="geometry"/></mxCell><mxCell id="actions" value="MATCH ACTION&#xa;&#xa;ALLOW = final permit, stop&#xa;DENY = final drop, stop&#xa;APPLY_SECURITY_PROFILE_GROUP = hand flow to inspection, stop normal rule evaluation&#xa;GOTO_NEXT = leave this policy and continue to the next policy/evaluation stage" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#f0fdf4;strokeColor=#16a34a;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="500" y="470" width="520" height="260" as="geometry"/></mxCell><mxCell id="spg" value="Security Profile Group&#xa;&#xa;Hierarchical rule → organization-level SPG only&#xa;Global network policy → organization- or project-level SPG" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#fef3c7;strokeColor=#d97706;" vertex="1" parent="1"><mxGeometry x="1130" y="180" width="500" height="165" as="geometry"/></mxCell><mxCell id="nsi" value="NSI / intercept endpoint group&#xa;transparent packet interception" style="rounded=1;whiteSpace=wrap;html=1;fontSize=19;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="1200" y="430" width="360" height="110" as="geometry"/></mxCell><mxCell id="pan" value="VM-Series / inspection service&#xa;stateful firewall verdict&#xa;ALLOW or DROP" style="rounded=1;whiteSpace=wrap;html=1;fontSize=19;fillColor=#fce7f3;strokeColor=#be185d;" vertex="1" parent="1"><mxGeometry x="1200" y="625" width="360" height="120" as="geometry"/></mxCell><mxCell id="note" value="Key mental model:&#xa;Hierarchy = who gets first say. Priority = which rule inside that policy gets first say. goto_next = ask the next stage. apply_security_profile_group = inspection owns the decision." style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#f8fafc;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="470" y="820" width="1110" height="130" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#4f46e5;endArrow=block;" edge="1" parent="1" source="org" target="folder1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#4f46e5;endArrow=block;" edge="1" parent="1" source="folder1" target="folder2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#4f46e5;endArrow=block;" edge="1" parent="1" source="folder2" target="project"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#0891b2;endArrow=block;" edge="1" parent="1" source="project" target="vpc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="evaluation descends" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#ea580c;endArrow=block;fontSize=15;" edge="1" parent="1" source="eval" target="actions"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="APPLY_SECURITY_PROFILE_GROUP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#d97706;endArrow=block;fontSize=15;" edge="1" parent="1" source="actions" target="spg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="560"/><mxPoint x="1060" y="260"/></Array></mxGeometry></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#2563eb;endArrow=block;" edge="1" parent="1" source="spg" target="nsi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#be185d;endArrow=block;" edge="1" parent="1" source="nsi" target="pan"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>