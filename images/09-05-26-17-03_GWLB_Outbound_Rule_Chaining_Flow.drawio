<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Private-Only VM Outbound Inspection — Exact GWLB / Standard LB Handoff" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="50" as="geometry"/></mxCell><mxCell id="consumer" value="Consumer: Standard Public Load Balancer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontSize=17;align=center;verticalAlign=middle;fontStyle=1;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="250" y="90" width="900" height="700" as="geometry"/></mxCell><mxCell id="provider" value="Provider: Gateway Load Balancer + NVA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a78bfa;strokeWidth=2;fontSize=17;align=center;verticalAlign=middle;fontStyle=1;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="1190" y="90" width="540" height="430" as="geometry"/></mxCell><mxCell id="vm" value="Private-only VM&#xa;10.0.1.4&#xa;No public IP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#334155;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="195" width="170" height="95" as="geometry"/></mxCell><mxCell id="pool" value="Backend pool&#xa;app-backend-pool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#334155;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="180" width="180" height="95" as="geometry"/></mxCell><mxCell id="rule" value="Outbound rule&#xa;myOutboundRule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#334155;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="555" y="180" width="180" height="95" as="geometry"/></mxCell><mxCell id="fe" value="Frontend IP configuration&#xa;myOutboundFrontend&#xa;Public IP 20.50.60.70" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#334155;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="810" y="165" width="255" height="125" as="geometry"/></mxCell><mxCell id="ref" value="gatewayLoadBalancer property&#xa;= resource ID of gwlb-frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810" y="345" width="255" height="95" as="geometry"/></mxCell><mxCell id="gwlb" value="Gateway Load Balancer&#xa;gwlb-frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#334155;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1240" y="180" width="190" height="95" as="geometry"/></mxCell><mxCell id="nva" value="Selected NVA&#xa;Stateful firewall" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#334155;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1495" y="175" width="180" height="105" as="geometry"/></mxCell><mxCell id="handoff" value="Return to the chained&#xa;Standard LB frontend /&#xa;outbound-rule processing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="555" width="310" height="120" as="geometry"/></mxCell><mxCell id="snat" value="Standard LB outbound SNAT&#xa;10.0.1.4 → 20.50.60.70&#xa;(using myOutboundFrontend)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#334155;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="555" width="285" height="120" as="geometry"/></mxCell><mxCell id="internet" value="Internet&#xa;destination" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#334155;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="570" width="190" height="90" as="geometry"/></mxCell><mxCell id="note" value="Key point: GWLB does not itself provide the Internet SNAT public IP. After inspection, Azure returns the flow to the chained Standard Load Balancer consumer context. The Standard LB outbound rule then uses the selected frontend public IP for SNAT." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="575" width="575" height="135" as="geometry"/></mxCell><mxCell id="e1" value="1  VM is a backend-pool member" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#2563eb;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vm" target="pool"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="235" y="242"/><mxPoint x="270" y="242"/></Array></mxGeometry></mxCell><mxCell id="e2" value="2  Outbound rule applies" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#2563eb;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="rule"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="228"/><mxPoint x="530" y="228"/></Array></mxGeometry></mxCell><mxCell id="e3" value="3  Rule selects this frontend" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#2563eb;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rule" target="fe"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="755" y="228"/><mxPoint x="785" y="228"/></Array></mxGeometry></mxCell><mxCell id="e4" value="4  Frontend reference invokes GWLB" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#2563eb;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe" target="gwlb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="228"/><mxPoint x="1160" y="228"/><mxPoint x="1160" y="228"/><mxPoint x="1215" y="228"/></Array></mxGeometry></mxCell><mxCell id="e5" value="5  VXLAN to selected NVA" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#7c3aed;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;dashed=1;dashPattern=10 8;" edge="1" parent="1" source="gwlb" target="nva"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1450" y="205"/><mxPoint x="1465" y="205"/></Array></mxGeometry></mxCell><mxCell id="e6" value="6  Inspected return" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#16a34a;exitX=0;exitY=0.72;exitDx=0;exitDy=0;entryX=1;entryY=0.72;entryDx=0;entryDy=0;dashed=1;dashPattern=10 8;" edge="1" parent="1" source="nva" target="gwlb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1470" y="252"/><mxPoint x="1470" y="330"/><mxPoint x="1450" y="330"/><mxPoint x="1450" y="252"/></Array></mxGeometry></mxCell><mxCell id="e7" value="7  Back to consumer resource" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gwlb" target="handoff"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1335" y="310"/><mxPoint x="1335" y="500"/><mxPoint x="1110" y="500"/><mxPoint x="1110" y="615"/><mxPoint x="1090" y="615"/></Array></mxGeometry></mxCell><mxCell id="e8" value="8  Resume Standard LB outbound processing" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#2563eb;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="handoff" target="snat"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="735" y="615"/><mxPoint x="690" y="615"/></Array></mxGeometry></mxCell><mxCell id="e9" value="9  SNAT and send to Internet" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#2563eb;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="snat" target="internet"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="615"/><mxPoint x="260" y="615"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>