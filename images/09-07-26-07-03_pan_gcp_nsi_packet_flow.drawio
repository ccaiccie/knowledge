<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="VM-Series + Google Cloud NSI — in-band inspection packet flow" style="text;html=1;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1400" height="50" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;Consumer VPC&lt;/b&gt;&lt;br/&gt;client 10.10.1.10&lt;br/&gt;server 10.10.2.20&lt;br/&gt;Normal VPC routes remain&lt;br/&gt;Firewall policy selects flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="160" width="270" height="180" as="geometry"/></mxCell><mxCell id="p" value="&lt;b&gt;Firewall policy + profile group&lt;/b&gt;&lt;br/&gt;apply_security_profile_group&lt;br/&gt;Custom-intercept profile&lt;br/&gt;References endpoint group&lt;br/&gt;Match by tags/CIDRs/protocols" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f29900;fontSize=15;" vertex="1" parent="1"><mxGeometry x="390" y="120" width="310" height="220" as="geometry"/></mxCell><mxCell id="e" value="&lt;b&gt;Intercept endpoint group&lt;/b&gt;&lt;br/&gt;Global consumer-facing resource&lt;br/&gt;Points to producer deployment group&lt;br/&gt;Associated to consumer VPC(s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#9334e6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="770" y="120" width="300" height="220" as="geometry"/></mxCell><mxCell id="f" value="&lt;b&gt;VM-Series PAN-OS&lt;/b&gt;&lt;br/&gt;GENEVE inspection enabled&lt;br/&gt;Inspect original inner packet&lt;br/&gt;Allow → reinject&lt;br/&gt;Deny → drop + log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#d93025;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1170" y="120" width="300" height="220" as="geometry"/></mxCell><mxCell id="d" value="&lt;b&gt;Producer deployment gro