<mxfile host="app.diagrams.net" modified="2026-09-06T22:45:00.000Z" agent="ChatGPT"><diagram id="egress" name="Internet Egress"><mxGraphModel dx="1900" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageWidth="1900" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Centralized Internet Egress — Spoke → TGW → Inspection VPC → GWLBE/GWLB/NGFW → NAT → IGW" style="text;html=1;fontSize=28;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1650" height="40" as="geometry"/></mxCell><mxCell id="sp" value="Spoke A 10.10.0.0/16&#xa;EC2-A 10.10.10.10&#xa;RT-A-App: 0.0.0.0/0 → tgw-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f59e0b;strokeWidth=3;fontSize=16" vertex="1" parent="1"><mxGeometry x="40" y="130" width="300" height="125" as="geometry"/></mxCell><mxCell id="tgw" value="TGW-RT-SPOKES&#xa;0.0.0.0/0 → att-Inspection&#xa;Associated with spoke attachments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=3;fontFamily=Courier New;fontSize=14" vertex="1" parent="1"><mxGeometry x="430" y="130" width="320" height="125" as="geometry"/></mxCell><mxCell id="in" value="Inspection TGW subnet AZ-a&#xa;10.255.200.0/28&#xa;RT-Insp-TGW-a: 0.0.0.0/0 → vpce-gwlb-a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#64748b;strokeWidth=2;fontFamily=Courier New;fontSize=14" vertex="1" parent="1"><mxGeometry x="840" y="120" width="360" height="145" as="geometry"/></mxCell><mxCell id="g" value="GWLBE-a 10.255.100.0/28&#xa;GWLB endpoint service&#xa;GWLB → GENEVE/6081 → NGFW&#xa;RT-GWLBE-a: 0.0.0.0/0 → nat-a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=3;fontFamily=Courier New;fontSize=14" vertex="1" parent="1"><mxGeometry x="1290" y="110" width="390" height="165" as="geometry"/></mxCell><mxCell id="nat" value="NAT Gateway nat-a&#xa;Public subnet 10.255.40.0/24&#xa;SNAT: 10.10.10.10 → EIP&#xa;RT-NAT-a: 0.0.0.0/0 → igw-inspection&#xa;10.10.0.0/16 → vpce-gwlb-a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#16a34a;strokeWidth=3;fontFamily=Courier New;fontSize=14" vertex="1" parent="1"><mxGeometry x="1290" y="390" width="390" height="185" as="geometry"/></mxCell><mxCell id="igw" value="Internet Gateway&#xa;→ Internet 1.1.1.1:443" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4f46e5;strokeWidth=3;fontSize=17" vertex="1" parent="1"><mxGeometry x="1290" y="690" width="390" height="105" as="geometry"/></mxCell><mxCell id="ret" value="Return path&#xa;&#xa;Internet → IGW → NAT Gateway performs reverse NAT → NAT-subnet route for 10.10.0.0/16 sends packet to GWLBE-a → GWLB/NGFW → same GWLBE → GWLBE-subnet route 10.10.0.0/16 → TGW → TGW-RT-INSPECTION → Spoke A attachment → EC2-A.&#xa;&#xa;The NAT subnet's more-specific spoke routes are critical; otherwise reverse-translated traffic can bypass inspection." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontSize=15;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="80" y="390" width="1040" height="300" as="geometry"/></mxCell><mxCell id="ir" value="TGW-RT-INSPECTION&#xa;10.10.0.0/16 → att-Spoke-A&#xa;10.20.0.0/16 → att-Spoke-B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=3;fontFamily=Courier New;fontSize=14" vertex="1" parent="1"><mxGeometry x="430" y="760" width="330" height="120" as="geometry"/></mxCell><mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="sp" target="tgw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="tgw" target="in"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="3 inspect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#dc2626;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="in" target="g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="4 NAT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="g" target="nat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="nat" target="igw"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>