<mxfile host="app.diagrams.net" modified="2026-09-07T14:05:00.000Z" agent="ChatGPT" version="24.7.17"><diagram id="packet-flow" name="Packet Flow"><mxGraphModel page="1" pageWidth="1600" pageHeight="900" grid="1" gridSize="10"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="client" value="Client VM&#xa;10.10.1.10:49152" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;fontSize=16;" vertex="1" parent="1"><mxGeometry x="70" y="330" width="210" height="90" as="geometry"/></mxCell><mxCell id="policy" value="Firewall policy engine&#xa;EGRESS rule priority 200&#xa;dst 0.0.0.0/0 tcp:443&#xa;apply_security_profile_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;fontSize=15;" vertex="1" parent="1"><mxGeometry x="360" y="290" width="290" height="160" as="geometry"/></mxCell><mxCell id="pi" value="Google Packet Intercept&#xa;Preserves original routing intent&#xa;Adds VPC network identifier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=15;" vertex="1" parent="1"><mxGeometry x="740" y="310" width="270" height="120" as="geometry"/></mxCell><mxCell id="fw" value="Firewall endpoint&#xa;TLS decrypt (if enabled)&#xa;IPS / URL / malware inspection&#xa;Re-encrypt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#ea4335;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1090" y="280" width="270" height="180" as="geometry"/></mxCell><mxCell id="dest" value="Destination&#xa;203.0.113.20:443" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#5f6368;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1430" y="330" width="150" height="90" as="geometry"/></mxCell><mxCell id="return" value="Return packets use the connection-tracking state created by apply_security_profile_group and are intercepted for the same flow. No user-managed firewall next-hop route is inserted." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#a142f4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="610" width="760" height="90" as="geometry"/></mxCell><mxCell id="a1" value="1. new connection" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#1a73e8;fontSize=13;" edge="1" parent="1" source="client" target="policy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" value="2. rule match → intercept" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#f9ab00;fontSize=13;" edge="1" parent="1" source="policy" target="pi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a3" value="3. transparently diverted" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#34a853;fontSize=13;" edge="1" parent="1" source="pi" target="fw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a4" value="4. approved + reinjected" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#ea4335;fontSize=13;" edge="1" parent="1" source="fw" target="dest"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a5" value="5. return flow" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#a142f4;fontSize=13;dashed=1;" edge="1" parent="1" source="dest" target="client"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1505" y="520"/><mxPoint x="175" y="520"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>