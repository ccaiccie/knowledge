<mxfile host="app.diagrams.net"><diagram name="Mental Model: Leak the Route, Not the Packet"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b0" value="&lt;b&gt;Global VRF / Default RIB&lt;/b&gt;&lt;br&gt;10.50.50.0/24 = connected&lt;br&gt;0.0.0.0/0 = upstream&lt;br&gt;No VRF-103 routes initially" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="290" height="200" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;IOS XE Router&lt;/b&gt;&lt;br&gt;route-replicate selects prefixes&lt;br&gt;Destination RIB installs replica&lt;br&gt;RIB decides forwarding&lt;br&gt;Redistribution is separate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="455" y="120" width="290" height="260" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;VRF 103 RIB&lt;/b&gt;&lt;br&gt;10.10.10.0/24 = connected&lt;br&gt;No global routes initially&lt;br&gt;Leaked route appears with +" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="840" y="150" width="290" height="200" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;Routing Neighbor&lt;/b&gt;&lt;br&gt;BGP / OSPF / EIGRP&lt;br&gt;Learns only after redistribution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="455" y="455" width="290" height="120" as="geometry"/></mxCell><mxCell id="e0" value="1. replicate selected route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=4;endArrow=block;endFill=1;fontStyle=1;fontSize=13;" edge="1" parent="1" source="b0" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="2. install in destination RIB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=4;endArrow=block;endFill=1;fontStyle=1;fontSize=13;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="3. redistribute if neighbor must learn it" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333ea;strokeWidth=4;endArrow=block;endFill=1;fontStyle=1;fontSize=13;" edge="1" parent="1" source="b1" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>