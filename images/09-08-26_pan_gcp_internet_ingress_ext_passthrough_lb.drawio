        <mxCell id="f2" value="2  Passthrough LB preserves original client IP and selects active backend" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="elb" target="fw1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="575" y="95"/><mxPoint x="718" y="95"/></Array></mxGeometry></mxCell>
        <mxCell id="f3" value="3  PAN-OS policy lookup + DNAT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="fw1" target="nat"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="115"/><mxPoint x="1135" y="115"/></Array></mxGeometry></mxCell>
        <mxCell id="f4" value="4  Allowed packet routed out trust toward 10.0.2.4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="nat" target="app"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="115"/><mxPoint x="1435" y="115"/></Array></mxGeometry></mxCell>
        <mxCell id="r1" value="5  Response 10.0.2.4:80 → client returns through firewall" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;dashed=1;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="app" target="nat"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1435" y="395"/><mxPoint x="1135" y="395"/></Array></mxGeometry></mxCell>
        <mxCell id="r2" value="6  Existing session lookup + reverse DNAT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;dashed=1;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="nat" target="fw1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1135" y="430"/><mxPoint x="718" y="430"/></Array></mxGeometry></mxCell>
