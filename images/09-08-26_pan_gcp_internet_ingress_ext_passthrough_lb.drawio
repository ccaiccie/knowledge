        <mxCell id="fw1" value="Active VM-Series&#xa;untrust NIC0&#xa;PAN-OS session owner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14" vertex="1" parent="1"><mxGeometry x="655" y="155" width="125" height="120" as="geometry"/></mxCell>
        <mxCell id="fw2" value="Passive VM-Series&#xa;untrust NIC0&#xa;health check fails until active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14" vertex="1" parent="1"><mxGeometry x="805" y="155" width="125" height="120" as="geometry"/></mxCell>
