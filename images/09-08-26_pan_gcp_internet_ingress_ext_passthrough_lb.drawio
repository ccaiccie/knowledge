        <mxCell id="note" value="Key requirement: return traffic must traverse the same logical VM-Series state owner so reverse NAT and the existing PAN-OS session are used. In active/passive, Palo Alto requires an external passthrough load balancer because it supports connection tracking." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14" vertex="1" parent="1"><mxGeometry x="390" y="500" width="820" height="90" as="geometry"/></mxCell>
