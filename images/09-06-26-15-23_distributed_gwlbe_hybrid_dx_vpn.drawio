<mxfile host="app.diagrams.net" modified="2026-09-06T22:23:00.000Z" agent="ChatGPT"><diagram id="hybrid" name="Hybrid DX VPN"><mxGraphModel dx="1900" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageWidth="1900" pageHeight="1300"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hybrid Enforcement — Direct Connect Transit VIF / DXGW / TGW and Site-to-Site VPN" style="text;html=1;fontSize=28;fontStyle=1;align=left" vertex="1" parent="1"><mxGeometry x="35" y="15" width="1600" height="45" as="geometry"/></mxCell><mxCell id="op" value="On-premises 172.16.0.0/16" style="swimlane;html=1;rounded=1;startSize=40;strokeColor=#f59e0b;strokeWidth=3;fillColor=#fff7ed;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="25" y="80" width="500" height="1120" as="geometry"/></mxCell><mxCell id="rtr" value="Corporate router pair&#xa;Advertise 172.16.0.0/16 using BGP&#xa;Receive AWS allowed prefixes, e.g. 10.10.0.0/16 + 10.20.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15" vertex="1" parent="1"><mxGeometry x="60" y="150" width="420" height="100" as="geometry"/></mxCell><mxCell id="dx" value="Direct Connect&#xa;Transit VIF&#xa;Customer VLAN/BGP&#xa;→ DX Gateway&#xa;→ TGW association" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15" vertex="1" parent="1"><mxGeometry x="60" y="310" width="190" height="145" as="geometry"/></mxCell><mxCell id="vpn" value="Site-to-Site VPN&#xa;2 IPsec tunnels&#xa;BGP to TGW&#xa;Backup or primary&#xa;vpn-attachment" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15" vertex="1" parent="1"><mxGeometry x="290" y="310" width="190" height="145" as="geometry"/></mxCell><mxCell id="bgp" value="BGP / route-selection notes&#xa;&#xa;Transit VIF does NOT terminate on a VPC.&#xa;Path: DX connection → Transit VIF → DXGW → TGW DXGW attachment.&#xa;TGW can propagate routes learned from DXGW and VPN attachments.&#xa;For equal prefixes, TGW route priority prefers DXGW-propagated routes over ordinary Site-to-Site VPN-propagated routes.&#xa;A static route can override propagated paths; use intentionally." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=15;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="60" y="525" width="420" height="260" as="geometry"/></mxCell><mxCell id="allow" value="DXGW allowed-prefix example&#xa;&#xa;10.10.0.0/16&#xa;10.20.0.0/16&#xa;&#xa;These are advertised by the Direct Connect gateway toward on-premises. They do not themselves force inspection; inspection is enforced by route tables inside each spoke at the TGW ingress/egress boundary." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=15;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="60" y="845" width="420" height="250" as="geometry"/></mxCell><mxCell id="tg" value="AWS Transit Gateway tgw-1" style="swimlane;html=1;rounded=1;startSize=40;strokeColor=#f59e0b;strokeWidth=3;fillColor=#fff7ed;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="565" y="80" width="555" height="1120" as="geometry"/></mxCell><mxCell id="hrt" value="Hybrid attachment-side TGW route table&#xa;10.10.0.0/16 → att-Spoke-A&#xa;10.20.0.0/16 → att-Spoke-B&#xa;Associate DXGW and VPN attachments here for inbound routing." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=14;fontFamily=Courier New;align=left;spacingLeft=12" vertex="1" parent="1"><mxGeometry x="600" y="150" width="485" height="130" as="geometry"/></mxCell><mxCell id="srt" value="Spoke-side TGW route table&#xa;172.16.0.0/16 → att-DXGW (preferred propagated example)&#xa;172.16.0.0/16 → att-VPN (backup; appears when preferred withdrawn)&#xa;Associate Spoke A/B attachments here.&#xa;Do not point hybrid traffic to a centralized inspection VPC in this pattern." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=14;fontFamily=Courier New;align=left;spacingLeft=12" vertex="1" parent="1"><mxGeometry x="600" y="330" width="485" height="155" as="geometry"/></mxCell><mxCell id="eval" value="TGW route evaluation that matters&#xa;&#xa;1. Longest prefix match wins.&#xa;2. Same CIDR: static > prefix-list > VPC propagated > DXGW propagated > Connect > private-DX VPN > Site-to-Site VPN propagated.&#xa;3. Same attachment type: shorter AS_PATH, then lower MED.&#xa;TGW shows the preferred route; backup may appear only after withdrawal." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=15;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="600" y="545" width="485" height="220" as="geometry"/></mxCell><mxCell id="enf" value="Where firewall state is enforced&#xa;&#xa;The TGW only chooses the target spoke attachment. Once packet reaches the spoke TGW ENI subnet, that subnet RT must steer the destination workload prefix to the local GWLBE. Return traffic from the workload subnet must steer 172.16.0.0/16 to the same local GWLBE before its endpoint-subnet RT sends to TGW." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#dc2626;strokeWidth=2;fillColor=#fef2f2;fontSize=15;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="600" y="825" width="485" height="235" as="geometry"/></mxCell><mxCell id="sp" value="Spoke A VPC 10.10.0.0/16 — distributed hybrid inspection" style="swimlane;html=1;rounded=1;startSize=40;strokeColor=#f59e0b;strokeWidth=3;fillColor=#fff7ed;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1160" y="80" width="715" height="1120" as="geometry"/></mxCell><mxCell id="tsa" value="TGW attach subnet A-a&#xa;10.10.200.0/28&#xa;Packet enters from DX/VPN via TGW" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15" vertex="1" parent="1"><mxGeometry x="1195" y="150" width="275" height="95" as="geometry"/></mxCell><mxCell id="gwa" value="GWLBE-A-a&#xa;10.10.100.0/28&#xa;→ central GWLB / NGFW fleet" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#dc2626;strokeWidth=2;fillColor=#fef2f2;fontSize=15" vertex="1" parent="1"><mxGeometry x="1540" y="150" width="275" height="95" as="geometry"/></mxCell><mxCell id="ec" value="EC2-A&#xa;10.10.10.10&#xa;App subnet 10.10.10.0/24" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15" vertex="1" parent="1"><mxGeometry x="1540" y="300" width="275" height="95" as="geometry"/></mxCell><mxCell id="sprt" value="Spoke A route tables — exact enforcement points&#xa;&#xa;RT-A-TGW-a (10.10.200.0/28)&#xa;10.10.0.0/16 → local&#xa;10.10.10.0/24 → vpce-gwlb-A-a # inbound on-prem → workload inspection&#xa;&#xa;RT-A-GWLBE-a (10.10.100.0/28)&#xa;10.10.0.0/16 → local # after inbound inspection to EC2&#xa;172.16.0.0/16 → tgw-1 # after outbound inspection to on-prem&#xa;&#xa;RT-A-App-a (10.10.10.0/24)&#xa;10.10.0.0/16 → local&#xa;172.16.0.0/16 → vpce-gwlb-A-a # workload → on-prem inspection&#xa;&#xa;Forward inbound tuple: 172.16.50.25:50000 → 10.10.10.10:443; no NAT required." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=14;fontFamily=Courier New;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="1195" y="445" width="620" height="400" as="geometry"/></mxCell><mxCell id="ret" value="Return path&#xa;10.10.10.10 → RT-A-App-a → GWLBE-A-a → central NGFW → GWLBE-A-a → RT-A-GWLBE-a 172.16.0.0/16 → TGW → preferred DXGW or VPN attachment → on-prem router. The local GWLBE is therefore traversed in both directions." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=15;align=left;spacing=12" vertex="1" parent="1"><mxGeometry x="1195" y="900" width="620" height="195" as="geometry"/></mxCell><mxCell id="e1" value="DX path" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="dx" target="hrt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="555" y="382"/><mxPoint x="575" y="215"/></Array></mxGeometry></mxCell><mxCell id="e2" value="VPN path" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="vpn" target="hrt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="382"/><mxPoint x="575" y="235"/></Array></mxGeometry></mxCell><mxCell id="e3" value="TGW → Spoke A" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="hrt" target="tsa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="inbound inspection" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="tsa" target="gwa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="gwa" target="ec"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>