<mxfile host="app.diagrams.net"><diagram name="Example 3: Why a One-Way Leak Often Fails"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b0" value="&lt;b&gt;VRF 103 Host&lt;/b&gt;&lt;br&gt;10.10.10.10&lt;br&gt;Has route to 10.50.50.53&lt;br&gt;Sends request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="205" width="250" height="155" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;Router — Misconfigured&lt;/b&gt;&lt;br&gt;Global 10.50.50.0/24 leaked → VRF 103&lt;br&gt;BUT 10.10.10.0/24 not leaked → global&lt;br&gt;Forward lookup succeeds&lt;br&gt;Return lookup fails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="445" y="145" width="310" height="275" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;Global Service&lt;/b&gt;&lt;br&gt;10.50.50.53&lt;br&gt;Receives request&lt;br&gt;Sends reply to 10.10.10.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="900" y="205" width="250" height="155" as="geometry"/></mxCell><mxCell id="e0" value="1  Forward route exists" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=4;endArrow=block;endFill=1;fontStyle=1;fontSize=13;" edge="1" parent="1" source="b0" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="2  Request reaches server" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=4;endArrow=block;endFill=1;fontStyle=1;fontSize=13;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="3  Reply returns to router" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=4;endArrow=block;endFill=1;fontStyle=1;fontSize=13;" edge="1" parent="1" source="b2" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="4  DROP / no route to 10.10.10.0/24 in Global RIB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=4;endArrow=block;endFill=1;fontStyle=1;fontSize=13;" edge="1" parent="1" source="b1" target="b0"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>