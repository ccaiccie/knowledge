<mxfile host="app.diagrams.net" modified="2026-09-06T22:23:00.000Z" agent="ChatGPT"><diagram id="ew" name="East-West"><mxGraphModel dx="1900" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageWidth="1900" pageHeight="1180"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="East-West Enforcement — Spoke A 10.10.0.0/16 ↔ Spoke B 10.20.0.0/16" style="text;html=1;fontSize=28;fontStyle=1;align=left" vertex="1" parent="1"><mxGeometry x="35" y="15" width="1500" height="45" as="geometry"/></mxCell><mxCell id="A" value="Spoke A" style="swimlane;html=1;rounded=1;startSize=40;strokeColor=#f59e0b;strokeWidth=3;fillColor=#fff7ed;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="25" y="80" width="640" height="950" as="geometry"/></mxCell><mxCell id="eca" value="EC2-A&#xa;10.10.10.10 / app-a 10.10.10.0/24&#xa;Source flow: → 10.20.10.20:443" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15;align=left;spacingLeft=12" vertex="1" parent="1"><mxGeometry x="55" y="150" width="230" height="95" as="geometry"/></mxCell><mxCell id="ga" value="GWLBE-A-a&#xa;10.10.100.0/28&#xa;Distributed inspection entry/return" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#dc2626;strokeWidth=2;fillColor=#fef2f2;fontSize=15;align=left;spacingLeft=12" vertex="1" parent="1"><mxGeometry x="360" y="150" width="245" height="95" as="geometry"/></mxCell><mxCell id="ta" value="TGW attach subnet A-a&#xa;10.10.200.0/28 → tgw-1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15;align=left;spacingLeft=12" vertex="1" parent="1"><mxGeometry x="360" y="300" width="245" height="90" as="geometry"/></mxCell><mxCell id="rta" value="Spoke A route tables&#xa;&#xa;RT-A-App-a&#xa;10.10.0.0/16 local&#xa;10.20.0.0/16 → vpce-gwlb-A-a&#xa;&#xa;RT-A-GWLBE-a&#xa;10.10.0.0/16 local&#xa;10.20.0.0/16 → tgw-1&#xa;&#xa;RT-A-TGW-a&#xa;10.10.0.0/16 local&#xa;10.10.10.0/24 → vpce-gwlb-A-a&#xa;&#xa;Return enforcement: packet arriving from TGW for EC2-A hits RT-A-TGW-a, is sent through the same local GWLBE, then the GWLBE subnet local route reaches EC2-A." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=14;fontFamily=Courier New;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="55" y="445" width="550" height="425" as="geometry"/></mxCell><mxCell id="C" value="Transit + centralized firewall service" style="swimlane;html=1;rounded=1;startSize=40;strokeColor=#f59e0b;strokeWidth=3;fillColor=#fff7ed;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="710" y="80" width="480" height="950" as="geometry"/></mxCell><mxCell id="tgw" value="AWS Transit Gateway tgw-1&#xa;RT-Spoke: 10.20.0.0/16 → att-Spoke-B&#xa;RT-Spoke: 10.10.0.0/16 → att-Spoke-A&#xa;No centralized inspection attachment in this pattern" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=14;fontFamily=Courier New;align=left;spacingLeft=12" vertex="1" parent="1"><mxGeometry x="740" y="150" width="420" height="120" as="geometry"/></mxCell><mxCell id="svc" value="GWLB endpoint service&#xa;GWLBE-A/B → AWS PrivateLink → GWLB&#xa;GWLB → GENEVE UDP/6081 → healthy NGFW&#xa;Allowed packet returns to SAME GWLBE" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#dc2626;strokeWidth=2;fillColor=#fef2f2;fontSize=15;align=left;spacingLeft=12" vertex="1" parent="1"><mxGeometry x="740" y="335" width="420" height="120" as="geometry"/></mxCell><mxCell id="fw" value="NGFW fleet — Security VPC 10.255.0.0/16&#xa;AZ-a NGFW 10.255.10.10&#xa;AZ-b NGFW 10.255.20.10&#xa;Original source/destination tuple inspected" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15;align=left;spacingLeft=12" vertex="1" parent="1"><mxGeometry x="740" y="510" width="420" height="120" as="geometry"/></mxCell><mxCell id="policy" value="Inspection policy choices&#xa;&#xa;A. Source-VPC enforcement only: A outbound + A return both traverse GWLBE-A.&#xa;&#xa;B. Both VPCs enforce: A outbound crosses GWLBE-A and B inbound crosses GWLBE-B. Return crosses B outbound and A inbound.&#xa;&#xa;Result: same connection may be inspected twice per direction." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=15;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="740" y="690" width="420" height="245" as="geometry"/></mxCell><mxCell id="B" value="Spoke B" style="swimlane;html=1;rounded=1;startSize=40;strokeColor=#f59e0b;strokeWidth=3;fillColor=#fff7ed;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1235" y="80" width="640" height="950" as="geometry"/></mxCell><mxCell id="tb" value="TGW attach subnet B-a&#xa;10.20.200.0/28&#xa;Inbound route → GWLBE-B-a" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15;align=left;spacingLeft=12" vertex="1" parent="1"><mxGeometry x="1295" y="150" width="245" height="95" as="geometry"/></mxCell><mxCell id="gb" value="GWLBE-B-a&#xa;10.20.100.0/28&#xa;Optional destination-side enforcement" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#dc2626;strokeWidth=2;fillColor=#fef2f2;fontSize=15;align=left;spacingLeft=12" vertex="1" parent="1"><mxGeometry x="1600" y="150" width="235" height="95" as="geometry"/></mxCell><mxCell id="ecb" value="EC2-B&#xa;10.20.10.20 / app-b 10.20.10.0/24&#xa;Destination TCP/443" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15;align=left;spacingLeft=12" vertex="1" parent="1"><mxGeometry x="1600" y="300" width="235" height="95" as="geometry"/></mxCell><mxCell id="rtb" value="Spoke B route tables when destination-side inspection is enabled&#xa;&#xa;RT-B-TGW-a&#xa;10.20.0.0/16 local&#xa;10.20.10.0/24 → vpce-gwlb-B-a&#xa;&#xa;RT-B-GWLBE-a&#xa;10.20.0.0/16 local&#xa;10.10.0.0/16 → tgw-1&#xa;&#xa;RT-B-App-a&#xa;10.20.0.0/16 local&#xa;10.10.0.0/16 → vpce-gwlb-B-a&#xa;&#xa;For source-only enforcement, omit B-side steering and let TGW reach B locally. A-side inbound TGW route still forces return through GWLBE-A before EC2-A." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=14;fontFamily=Courier New;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="1295" y="445" width="540" height="425" as="geometry"/></mxCell><mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="eca" target="ga"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="2 PrivateLink" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="ga" target="svc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="197"/><mxPoint x="710" y="395"/></Array></mxGeometry></mxCell><mxCell id="e3" value="3 GENEVE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="svc" target="fw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="4 allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="svc" target="ta"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="395"/><mxPoint x="680" y="345"/></Array></mxGeometry></mxCell><mxCell id="e5" value="5 TGW" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="ta" target="tgw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="345"/><mxPoint x="710" y="210"/></Array></mxGeometry></mxCell><mxCell id="e6" value="6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="tgw" target="tb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="7 destination enforcement" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="tb" target="gb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="gb" target="ecb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Forward tuple remains 10.10.10.10:ephemeral → 10.20.10.20:443 through TGW and GWLBE; no SNAT is required for this transparent east-west service-insertion path. Return flow reverses the same enforcement points. If both spokes enforce, logging/policy sees two service-chain traversals per direction." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=15;align=left;spacing=12" vertex="1" parent="1"><mxGeometry x="35" y="1060" width="1830" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>