<mxfile host="app.diagrams.net" modified="2026-09-06T22:55:00.000Z" agent="ChatGPT"><diagram id="ew" name="East-West"><mxGraphModel dx="1900" dy="1220" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageWidth="1900" pageHeight="1220"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="East-West — Distributed GWLBE Enforcement with TGW Used Only as Inter-VPC Transport" style="text;html=1;fontSize=28;fontStyle=1;align=left" vertex="1" parent="1"><mxGeometry x="35" y="15" width="1700" height="45" as="geometry"/></mxCell><mxCell id="A" value="Spoke A — enforcement VPC 10.10.0.0/16" style="swimlane;html=1;rounded=1;startSize=40;strokeColor=#f59e0b;strokeWidth=3;fillColor=#fff7ed;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="25" y="80" width="590" height="960" as="geometry"/></mxCell><mxCell id="eca" value="EC2-A&#xa;10.10.10.10&#xa;Destination 10.20.10.20:443" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15" vertex="1" parent="1"><mxGeometry x="55" y="150" width="225" height="90" as="geometry"/></mxCell><mxCell id="ga" value="GWLBE-A-a&#xa;Subnet 10.10.100.0/28&#xa;Actual inspection insertion point" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#dc2626;strokeWidth=2;fillColor=#fef2f2;fontSize=15" vertex="1" parent="1"><mxGeometry x="335" y="150" width="240" height="90" as="geometry"/></mxCell><mxCell id="ta" value="TGW attachment subnet&#xa;10.10.200.0/28&#xa;Transport toward tgw-1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15" vertex="1" parent="1"><mxGeometry x="335" y="305" width="240" height="90" as="geometry"/></mxCell><mxCell id="rta" value="Spoke A route tables — source-side enforcement&#xa;&#xa;RT-A-App-a (10.10.10.0/24)&#xa;10.10.0.0/16 → local&#xa;10.20.0.0/16 → vpce-gwlb-A-a&#xa;&#xa;RT-A-GWLBE-a (10.10.100.0/28)&#xa;10.10.0.0/16 → local&#xa;10.20.0.0/16 → tgw-1&#xa;&#xa;RT-A-TGW-a (10.10.200.0/28)&#xa;10.10.0.0/16 → local&#xa;10.10.10.0/24 → vpce-gwlb-A-a&#xa;&#xa;TGW never points to the Security VPC in this model." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=14;fontFamily=Courier New;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="55" y="445" width="520" height="430" as="geometry"/></mxCell><mxCell id="C" value="Transport plane + centralized firewall service" style="swimlane;html=1;rounded=1;startSize=40;strokeColor=#64748b;strokeWidth=3;fillColor=#f8fafc;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="655" y="80" width="590" height="960" as="geometry"/></mxCell><mxCell id="tgw" value="AWS Transit Gateway tgw-1 — TRANSPORT ONLY&#xa;10.10.0.0/16 → att-Spoke-A&#xa;10.20.0.0/16 → att-Spoke-B&#xa;No Security/Inspection VPC next hop in this pattern" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=14;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="690" y="150" width="520" height="125" as="geometry"/></mxCell><mxCell id="svc" value="Central GWLB endpoint service&#xa;GWLBE-A → PrivateLink → GWLB&#xa;GWLB → GENEVE UDP/6081 → healthy NGFW&#xa;Allowed packet returns to same GWLBE-A context" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#dc2626;strokeWidth=2;fillColor=#fef2f2;fontSize=15" vertex="1" parent="1"><mxGeometry x="690" y="335" width="520" height="130" as="geometry"/></mxCell><mxCell id="fw" value="NGFW fleet — Security VPC 10.255.0.0/16&#xa;NGFW-A 10.255.10.10 | NGFW-B 10.255.20.10&#xa;Inspects inner tuple 10.10.10.10 → 10.20.10.20&#xa;Security VPC is service-provider location, not TGW transit hop" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15" vertex="1" parent="1"><mxGeometry x="690" y="520" width="520" height="125" as="geometry"/></mxCell><mxCell id="warn" value="Do not confuse this with canonical centralized TGW inspection&#xa;&#xa;Different method: Spoke A → TGW → Security VPC attachment → GWLBE → GWLB/NGFW → TGW → Spoke B&#xa;&#xa;That design uses an appliance/inspection VPC attachment and normally TGW appliance mode. This diagram instead uses local GWLBE insertion before/after TGW transport." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#d97706;strokeWidth=2;fillColor=#fffbeb;fontSize=15;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="690" y="710" width="520" height="235" as="geometry"/></mxCell><mxCell id="B" value="Spoke B — destination VPC 10.20.0.0/16" style="swimlane;html=1;rounded=1;startSize=40;strokeColor=#f59e0b;strokeWidth=3;fillColor=#fff7ed;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1285" y="80" width="590" height="960" as="geometry"/></mxCell><mxCell id="tb" value="TGW attachment subnet&#xa;10.20.200.0/28&#xa;Source-side-only model: route locally" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15" vertex="1" parent="1"><mxGeometry x="1320" y="150" width="245" height="90" as="geometry"/></mxCell><mxCell id="ecb" value="EC2-B&#xa;10.20.10.20&#xa;TCP/443 destination" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#fff;fontSize=15" vertex="1" parent="1"><mxGeometry x="1610" y="150" width="225" height="90" as="geometry"/></mxCell><mxCell id="rtb" value="Spoke B route tables — no destination-side inspection&#xa;&#xa;RT-B-TGW-a (10.20.200.0/28)&#xa;10.20.0.0/16 → local&#xa;&#xa;RT-B-App-a (10.20.10.0/24)&#xa;10.20.0.0/16 → local&#xa;10.10.0.0/16 → tgw-1&#xa;&#xa;Return reaches TGW directly; Spoke A performs return inspection." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=14;fontFamily=Courier New;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="1320" y="305" width="515" height="230" as="geometry"/></mxCell><mxCell id="optional" value="Optional second trust-boundary inspection — separate choice&#xa;&#xa;RT-B-TGW-a: 10.20.10.0/24 → GWLBE-B&#xa;RT-B-App-a: 10.10.0.0/16 → GWLBE-B&#xa;RT-B-GWLBE-a: 10.10.0.0/16 → tgw-1&#xa;&#xa;This adds another local service-chain traversal in Spoke B. It is not centralized TGW inspection, but it causes double inspection and duplicate policy/log processing." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#d97706;strokeWidth=2;fillColor=#fffbeb;fontSize=14;fontFamily=Courier New;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="1320" y="610" width="515" height="300" as="geometry"/></mxCell><mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="eca" target="ga"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="2 PrivateLink" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="ga" target="svc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="645" y="195"/><mxPoint x="670" y="400"/></Array></mxGeometry></mxCell><mxCell id="e3" value="3 GENEVE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="svc" target="fw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="4 allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="svc" target="ta"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="430"/><mxPoint x="625" y="350"/></Array></mxGeometry></mxCell><mxCell id="e5" value="5 to TGW" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="ta" target="tgw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="635" y="350"/><mxPoint x="655" y="212"/></Array></mxGeometry></mxCell><mxCell id="e6" value="6 transport" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="tgw" target="tb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="7 local" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="tb" target="ecb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Primary flow shown: source-side distributed GWLBE inspection only. TGW performs VPC-to-VPC transport and does not send traffic to the Security VPC. Return traffic reaches Spoke A through TGW and is steered through GWLBE-A by RT-A-TGW-a." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=15;align=left;spacing=12" vertex="1" parent="1"><mxGeometry x="35" y="1080" width="1830" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>