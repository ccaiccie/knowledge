<mxfile host="app.diagrams.net" modified="2026-09-07T01:00:00.000Z" agent="ChatGPT"><diagram id="ingress" name="Centralized Internet Ingress"><mxGraphModel dx="1900" dy="1220" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageWidth="1900" pageHeight="1220"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Centralized Internet Ingress — ALB → GWLBE → GWLB/NGFW → TGW → Private App VPC" style="text;html=1;fontSize=28;fontStyle=1;align=left" vertex="1" parent="1"><mxGeometry x="35" y="15" width="1700" height="45" as="geometry"/></mxCell><mxCell id="inet" value="Internet" style="swimlane;html=1;rounded=1;startSize=40;strokeColor=#2563eb;strokeWidth=3;fillColor=#eff6ff;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="25" y="80" width="300" height="1020" as="geometry"/></mxCell><mxCell id="client" value="Client&#xa;198.51.100.25:53000&#xa;HTTPS app1.example.com" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#ffffff;fontSize=15" vertex="1" parent="1"><mxGeometry x="60" y="155" width="225" height="90" as="geometry"/></mxCell><mxCell id="ing" value="Ingress VPC 10.254.0.0/16" style="swimlane;html=1;rounded=1;startSize=40;strokeColor=#f59e0b;strokeWidth=3;fillColor=#fff7ed;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="365" y="80" width="890" height="1020" as="geometry"/></mxCell><mxCell id="igw" value="Internet Gateway&#xa;igw-ingress" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#ffffff;fontSize=15" vertex="1" parent="1"><mxGeometry x="405" y="150" width="210" height="85" as="geometry"/></mxCell><mxCell id="alb" value="Internet-facing ALB&#xa;Public subnet AZ-a&#xa;10.254.10.0/27" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#ffffff;fontSize=15" vertex="1" parent="1"><mxGeometry x="670" y="150" width="250" height="105" as="geometry"/></mxCell><mxCell id="gwlbe" value="GWLBE-a&#xa;10.254.100.0/28&#xa;same-AZ insertion" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#dc2626;strokeWidth=2;fillColor=#fef2f2;fontSize=15" vertex="1" parent="1"><mxGeometry x="985" y="150" width="230" height="105" as="geometry"/></mxCell><mxCell id="fw" value="GWLB + NGFW&#xa;GENEVE UDP/6081&#xa;Inspect ALB→backend flow" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#dc2626;strokeWidth=2;fillColor=#fef2f2;fontSize=15" vertex="1" parent="1"><mxGeometry x="985" y="315" width="230" height="115" as="geometry"/></mxCell><mxCell id="tgsub" value="TGW attachment subnet&#xa;10.254.200.0/27&#xa;return enforcement point" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#ffffff;fontSize=15" vertex="1" parent="1"><mxGeometry x="670" y="315" width="250" height="105" as="geometry"/></mxCell><mxCell id="rts" value="Ingress VPC route tables — AZ-a&#xa;&#xa;RT-Ingress-ALB-a&#xa;10.254.0.0/16  → local&#xa;10.10.0.0/16   → vpce-gwlb-a&#xa;10.20.0.0/16   → vpce-gwlb-a&#xa;0.0.0.0/0      → igw-ingress&#xa;&#xa;RT-Ingress-GWLBE-a&#xa;10.254.0.0/16  → local&#xa;10.10.0.0/16   → tgw-1&#xa;10.20.0.0/16   → tgw-1&#xa;&#xa;RT-Ingress-TGW-a&#xa;10.254.0.0/16  → local&#xa;10.254.10.0/27 → vpce-gwlb-a  # more-specific return route&#xa;&#xa;ALB terminates the client connection. NGFW after ALB sees the backend flow.&#xa;Original client IP is normally carried in X-Forwarded-For for HTTP/HTTPS." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=14;fontFamily=Courier New;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="405" y="485" width="810" height="500" as="geometry"/></mxCell><mxCell id="right" value="Transit + Application VPC A" style="swimlane;html=1;rounded=1;startSize=40;strokeColor=#16a34a;strokeWidth=3;fillColor=#f0fdf4;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1295" y="80" width="580" height="1020" as="geometry"/></mxCell><mxCell id="tgw" value="Transit Gateway&#xa;TGW-RT-INGRESS: 10.10.0.0/16 → att-App-A&#xa;TGW-RT-APPS:    10.254.0.0/16 → att-Ingress&#xa;Ingress and app attachments use different routing perspectives" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#ffffff;fontSize=14;fontFamily=Courier New;align=left;spacingLeft=12" vertex="1" parent="1"><mxGeometry x="1335" y="150" width="500" height="125" as="geometry"/></mxCell><mxCell id="app" value="App VPC A 10.10.0.0/16&#xa;Backend subnet 10.10.10.0/24&#xa;Target 10.10.10.50:443" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#ffffff;fontSize=15" vertex="1" parent="1"><mxGeometry x="1335" y="335" width="500" height="105" as="geometry"/></mxCell><mxCell id="apprt" value="App subnet route table&#xa;&#xa;10.10.0.0/16  → local&#xa;10.254.0.0/16 → tgw-1&#xa;&#xa;Return traffic is toward the ALB backend connection, not directly toward the Internet client." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=14;fontFamily=Courier New;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="1335" y="500" width="500" height="205" as="geometry"/></mxCell><mxCell id="sym" value="Key symmetry rule&#xa;&#xa;TGW return enters Ingress TGW subnet → more-specific ALB-subnet route sends it to same-AZ GWLBE → NGFW → local route → ALB node.&#xa;&#xa;Do not assume TGW Appliance Mode alone solves ingress." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=15;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="1335" y="765" width="500" height="185" as="geometry"/></mxCell><mxCell id="e1" value="1 public HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="client" target="igw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="igw" target="alb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="3 backend route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="alb" target="gwlbe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="4 GENEVE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="gwlbe" target="fw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="5 allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="fw" target="tgsub"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="372"/><mxPoint x="950" y="367"/></Array></mxGeometry></mxCell><mxCell id="e6" value="6 GWLBE RT → TGW → App A" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="tgsub" target="tgw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="367"/><mxPoint x="630" y="275"/><mxPoint x="1255" y="275"/><mxPoint x="1255" y="212"/></Array></mxGeometry></mxCell><mxCell id="e7" value="7 return via TGW to Ingress attachment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="app" target="tgsub"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1585" y="470"/><mxPoint x="1265" y="470"/><mxPoint x="1265" y="390"/></Array></mxGeometry></mxCell><mxCell id="e8" value="8 RT-Ingress-TGW-a → GWLBE-a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="tgsub" target="gwlbe"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="970" y="390"/><mxPoint x="970" y="202"/></Array></mxGeometry></mxCell><mxCell id="e9" value="reverse state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="gwlbe" target="fw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="to ALB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="gwlbe" target="alb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Orange = client/backend forward direction. Blue = backend return direction. ALB creates a new backend flow, so the NGFW after ALB does not see the Internet client as the L3 source." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=15;align=left;spacing=12" vertex="1" parent="1"><mxGeometry x="35" y="1130" width="1830" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>