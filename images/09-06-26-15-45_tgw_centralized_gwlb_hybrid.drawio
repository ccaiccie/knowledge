<mxfile host="app.diagrams.net" modified="2026-09-06T22:45:00.000Z" agent="ChatGPT"><diagram id="hy" name="Hybrid"><mxGraphModel dx="1900" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageWidth="1900" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hybrid Inspection — Direct Connect / VPN → TGW → Central Inspection VPC → TGW → Spoke" style="text;html=1;fontSize=28;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1550" height="40" as="geometry"/></mxCell><mxCell id="on" value="On-prem 172.16.0.0/16&#xa;Router pair&#xa;Advertise 172.16.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=3;fontSize=16" vertex="1" parent="1"><mxGeometry x="40" y="130" width="280" height="120" as="geometry"/></mxCell><mxCell id="dx" value="Direct Connect path&#xa;Transit VIF → DXGW → TGW attachment&#xa;Preferred propagated path example" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4f46e5;strokeWidth=2;fontSize=15" vertex="1" parent="1"><mxGeometry x="390" y="90" width="330" height="125" as="geometry"/></mxCell><mxCell id="vpn" value="Site-to-Site VPN path&#xa;2 IPsec tunnels → TGW attachment&#xa;Backup propagated path example" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4f46e5;strokeWidth=2;fontSize=15" vertex="1" parent="1"><mxGeometry x="390" y="260" width="330" height="125" as="geometry"/></mxCell><mxCell id="hrt" value="TGW-RT-HYBRID&#xa;10.10.0.0/16 → att-Inspection&#xa;10.20.0.0/16 → att-Inspection&#xa;Associated with DXGW/VPN attachments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=3;fontFamily=Courier New;fontSize=14" vertex="1" parent="1"><mxGeometry x="790" y="130" width="360" height="150" as="geometry"/></mxCell><mxCell id="ins" value="Inspection VPC AZ-a&#xa;TGW subnet 10.255.200.0/28&#xa;RT-Insp-TGW-a: 10.10.0.0/16 → vpce-gwlb-a&#xa;GWLBE → GWLB → NGFW → GWLBE&#xa;RT-GWLBE-a: 10.10.0.0/16 → tgw-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=3;fontFamily=Courier New;fontSize=14" vertex="1" parent="1"><mxGeometry x="1240" y="110" width="460" height="190" as="geometry"/></mxCell><mxCell id="irt" value="TGW-RT-INSPECTION&#xa;10.10.0.0/16 → att-Spoke-A&#xa;10.20.0.0/16 → att-Spoke-B&#xa;172.16.0.0/16 → att-DXGW (preferred) / att-VPN backup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=3;fontFamily=Courier New;fontSize=14" vertex="1" parent="1"><mxGeometry x="1240" y="400" width="460" height="160" as="geometry"/></mxCell><mxCell id="sp" value="Spoke A VPC 10.10.0.0/16&#xa;TGW attachment → local app subnet&#xa;EC2-A 10.10.10.10&#xa;RT-A-App: 172.16.0.0/16 → tgw-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f59e0b;strokeWidth=3;fontSize=16" vertex="1" parent="1"><mxGeometry x="790" y="430" width="360" height="145" as="geometry"/></mxCell><mxCell id="ret" value="Return flow&#xa;&#xa;EC2-A → TGW → TGW-RT-SPOKES/HYBRID policy sends 172.16.0.0/16 to att-Inspection → Inspection TGW subnet → GWLBE/GWLB/NGFW → GWLBE → TGW → TGW-RT-INSPECTION selects DXGW or VPN attachment → on-prem.&#xa;&#xa;Inspection remains centralized. Direct Connect and VPN do not bypass the firewall merely because they terminate on TGW." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontSize=15;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="100" y="660" width="1600" height="220" as="geometry"/></mxCell><mxCell id="e1" value="DX" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="on" target="dx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="VPN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f46e5;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="on" target="vpn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="TGW ingress" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="dx" target="hrt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="vpn" target="hrt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="att-Inspection" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#dc2626;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="hrt" target="ins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="post-inspection" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="ins" target="irt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="att-Spoke-A" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="irt" target="sp"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>