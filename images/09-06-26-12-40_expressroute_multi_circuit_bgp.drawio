<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel page="1" pageWidth="1500" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Two locations, two ExpressRoute circuits: ECMP and failover" style="text;html=1;fontSize=26;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="15" width="900" height="45" as="geometry"/></mxCell><mxCell id="a" value="&lt;b&gt;Site A / Los Angeles&lt;/b&gt;&lt;br&gt;10.10.0.0/16 • ASN 65010" style="rounded=1;html=1;fillColor=#F1F8EE;strokeColor=#107C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="290" height="150" as="geometry"/></mxCell><mxCell id="b" value="&lt;b&gt;Site B / Dallas&lt;/b&gt;&lt;br&gt;10.20.0.0/16 • ASN 65010" style="rounded=1;html=1;fillColor=#F1F8EE;strokeColor=#107C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="290" height="150" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;ExpressRoute Circuit 1&lt;/b&gt;&lt;br&gt;Peering location A" style="rounded=1;html=1;fillColor=#FFF5EE;strokeColor=#D83B01;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="300" height="150" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;ExpressRoute Circuit 2&lt;/b&gt;&lt;br&gt;Peering location B" style="rounded=1;html=1;fillColor=#FFF5EE;strokeColor=#D83B01;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="420" y="440" width="300" height="150" as="geometry"/></mxCell><mxCell id="er" value="&lt;b&gt;Azure ER gateway / routing&lt;/b&gt;&lt;br&gt;Learns both BGP paths&lt;br&gt;Equal paths → ECMP&lt;br&gt;Prepend → primary / backup" style="rounded=1;html=1;fillColor=#EAF4FB;strokeColor=#0078D4;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="820" y="250" width="300" height="170" as="geometry"/></mxCell><mxCell id="v" value="&lt;b&gt;Azure VNet&lt;/b&gt;&lt;br&gt;10.50.0.0/16" style="rounded=1;html=1;fillColor=#EAF4FB;strokeColor=#0078D4;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1190" y="250" width="260" height="170" as="geometry"/></mxCell><mxCell id="e1" value="Advertise local prefix" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#107C10;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="a" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Advertise local prefix" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#107C10;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="b" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="BGP path 1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0078D4;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="c1" target="er"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="BGP path 2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0078D4;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="c2" target="er"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Selected/ECMP" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0078D4;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="er" target="v"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n" value="Azure → on-prem: AS-path / connection preference. On-prem → Azure: LOCAL_PREF. Align both directions when stateful firewalls exist.&lt;br&gt;If Circuit 1 is withdrawn, Circuit 2 becomes the surviving path; size each circuit for the required failover load." style="rounded=1;html=1;fillColor=#FFFBEA;strokeColor=#E6C84F;" vertex="1" parent="1"><mxGeometry x="260" y="650" width="980" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>