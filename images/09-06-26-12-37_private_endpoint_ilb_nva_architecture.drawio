<mxfile host="app.diagrams.net"><diagram name="Detailed ILB-NVA-PE"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1380"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Azure Private Endpoint Inspection — Standard ILB + HA Ports + Third-Party NVA Cluster" style="text;html=1;strokeColor=none;fillColor=none;fontSize=30;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="55" y="20" width="1500" height="45" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Detailed service-insertion topology showing source UDR, ILB distribution, health probing, NVA state/SNAT ownership, PE policy, forward/return symmetry, and failover behavior." style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontColor=#57606a;align=left;" vertex="1" parent="1"><mxGeometry x="55" y="65" width="1900" height="30" as="geometry"/></mxCell>
<mxCell id="dnsband" value="DNS / Control Plane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#8c959f;fontSize=21;fontStyle=1;verticalAlign=top;spacingTop=12;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="45" y="115" width="2110" height="175" as="geometry"/></mxCell>
<mxCell id="dnsq" value="Client DNS query&#xa;sql1.database.windows.net" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#0969da;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="178" width="290" height="78" as="geometry"/></mxCell>
<mxCell id="pdns" value="Private DNS zone / resolver path&#xa;privatelink.database.windows.net&#xa;A record → PE 10.20.1.4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#8250df;fontSize=15;" vertex="1" parent="1"><mxGeometry x="755" y="168" width="450" height="96" as="geometry"/></mxCell>
<mxCell id="routecond" value="Critical routing condition&#xa;PE network policies enabled for UDR/NSG enforcement.&#xa;0.0.0.0/0 alone does not beat the more-specific PE route." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#bf8700;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1420" y="168" width="640" height="96" as="geometry"/></mxCell>
<mxCell id="d1" value="D1. Query" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#8250df;strokeWidth=2;endArrow=block;endFill=1;fontSize=14;fontStyle=1;" edge="1" parent="1" source="dnsq" target="pdns"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="d2" value="D2. Answer = 10.20.1.4" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#8250df;strokeWidth=2;endArrow=block;endFill=1;fontSize=14;fontStyle=1;" edge="1" parent="1" source="pdns" target="dnsq"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="245"/></Array></mxGeometry></mxCell>
<mxCell id="workload" value="Workload Spoke VNet&#xa;10.10.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#8c959f;fontSize=21;fontStyle=1;verticalAlign=top;spacingTop=12;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="45" y="330" width="390" height="830" as="geometry"/></mxCell>
<mxCell id="hub" value="Hub VNet — NVA Service Insertion&#xa;10.0.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#bf8700;fontSize=21;fontStyle=1;verticalAlign=top;spacingTop=12;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="485" y="330" width="985" height="830" as="geometry"/></mxCell>
<mxCell id="pevnet" value="Private Endpoint VNet&#xa;10.20.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dafbe1;strokeColor=#1a7f37;fontSize=21;fontStyle=1;verticalAlign=top;spacingTop=12;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="1520" y="330" width="390" height="830" as="geometry"/></mxCell>
<mxCell id="paas" value="Azure PaaS&#xa;Azure SQL&#xa;Private Link" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddf4ff;strokeColor=#0969da;fontSize=18;fontStyle=1;verticalAlign=top;spacingTop=18;" vertex="1" parent="1"><mxGeometry x="1960" y="440" width="195" height="600" as="geometry"/></mxCell>
<mxCell id="client" value="Client VM&#xa;10.10.1.4&#xa;snet-app 10.10.1.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#0969da;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="95" y="475" width="290" height="125" as="geometry"/></mxCell>
<mxCell id="rt" value="Route Table: rt-app&#xa;10.20.0.0/16&#xa;Next hop: VirtualAppliance&#xa;10.0.2.10 (ILB frontend)&#xa;Attached to client subnet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3cd;strokeColor=#bf8700;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="690" width="320" height="175" as="geometry"/></mxCell>
<mxCell id="effective" value="Effective Route Check&#xa;PE prefix → VirtualAppliance&#xa;next hop 10.0.2.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c959f;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="925" width="320" height="120" as="geometry"/></mxCell>
<mxCell id="ilbbox" value="Standard Internal Load Balancer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bf8700;fontSize=18;fontStyle=1;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="535" y="455" width="350" height="240" as="geometry"/></mxCell>
<mxCell id="vip" value="Frontend VIP 10.0.2.10&#xa;UDR next-hop target&#xa;Standard SKU / internal frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3cd;strokeColor=#bf8700;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="575" y="525" width="270" height="95" as="geometry"/></mxCell>
<mxCell id="haports" value="HA Ports rule&#xa;Protocol All • Frontend 0 • Backend 0" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="575" y="635" width="270" height="55" as="geometry"/></mxCell>
<mxCell id="nvabox" value="NVA Backend Pool / Inspection Tier&#xa;NIC IP forwarding enabled • vendor-supported HA/DSR behavior required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cf222e;fontSize=18;fontStyle=1;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="935" y="440" width="480" height="610" as="geometry"/></mxCell>
<mxCell id="nva1" value="NVA-1 — Active flow owner&#xa;10.0.3.4&#xa;Policy + inspection + session state&#xa;SNAT PE-facing flow to NVA-owned address" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebe9;strokeColor=#cf222e;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="985" y="545" width="350" height="150" as="geometry"/></mxCell>
<mxCell id="nva2" value="NVA-2 — Healthy peer&#xa;10.0.3.5&#xa;Receives other/new flows from ILB&#xa;Existing-flow recovery depends on vendor state sync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebe9;strokeColor=#cf222e;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="985" y="760" width="350" height="150" as="geometry"/></mxCell>
<mxCell id="probe" value="Backend health probe&#xa;Only healthy NVAs receive new ILB flows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#8c959f;fontSize=15;" vertex="1" parent="1"><mxGeometry x="985" y="950" width="350" height="70" as="geometry"/></mxCell>
<mxCell id="state" value="Example state / NAT ownership&#xa;Original: 10.10.1.4:53000 → 10.20.1.4:1433&#xa;PE leg: NVA-SNAT:* → 10.20.1.4:1433&#xa;Return targets the same stateful NVA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c959f;fontSize=14;" vertex="1" parent="1"><mxGeometry x="535" y="900" width="360" height="145" as="geometry"/></mxCell>
<mxCell id="pesub" value="PE Subnet&#xa;10.20.1.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a7f37;fontSize=18;fontStyle=1;verticalAlign=top;spacingTop=14;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="1570" y="455" width="290" height="350" as="geometry"/></mxCell>
<mxCell id="pe" value="Private Endpoint NIC&#xa;10.20.1.4&#xa;Azure-managed PE NIC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcffe4;strokeColor=#1a7f37;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1605" y="555" width="220" height="130" as="geometry"/></mxCell>
<mxCell id="penp" value="PE Network Policies&#xa;ENABLED&#xa;Allows UDR / NSG enforcement&#xa;for Private Endpoint traffic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c959f;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1570" y="855" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="sql" value="SQL service&#xa;Private Link terminates on PaaS service&#xa;No public path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0969da;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1985" y="580" width="145" height="180" as="geometry"/></mxCell>
<mxCell id="peer1" value="VNet peering&#xa;allow forwarded traffic" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#57606a;align=center;" vertex="1" parent="1"><mxGeometry x="425" y="410" width="70" height="50" as="geometry"/></mxCell>
<mxCell id="peer2" value="VNet peering&#xa;hub ↔ PE VNet" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#57606a;align=center;" vertex="1" parent="1"><mxGeometry x="1460" y="410" width="70" height="50" as="geometry"/></mxCell>
<mxCell id="f1" value="1. Client UDR sends PE flow to ILB VIP&#xa;10.10.1.4:53000 → 10.20.1.4:1433" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0969da;strokeWidth=3;endArrow=block;endFill=1;fontSize=14;fontStyle=1;" edge="1" parent="1" source="client" target="vip"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f2" value="2. Flow hashes to NVA-1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0969da;strokeWidth=3;endArrow=block;endFill=1;fontSize=14;fontStyle=1;" edge="1" parent="1" source="vip" target="nva1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="alt" value="Other/new flows may hash to NVA-2" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#8c959f;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="vip" target="nva2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="health" value="Health state informs ILB" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#8250df;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="probe" target="ilbbox"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f3" value="3. NVA inspects + SNATs&#xa;PE-facing source becomes NVA-owned address" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0969da;strokeWidth=3;endArrow=block;endFill=1;fontSize=14;fontStyle=1;" edge="1" parent="1" source="nva1" target="pe"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f4" value="4. Private Link" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0969da;strokeWidth=3;endArrow=block;endFill=1;fontSize=14;fontStyle=1;" edge="1" parent="1" source="pe" target="sql"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="r1" value="5. Service reply returns through PE" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a7f37;strokeWidth=3;endArrow=block;endFill=1;fontSize=14;fontStyle=1;" edge="1" parent="1" source="sql" target="pe"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1905" y="715"/></Array></mxGeometry></mxCell>
<mxCell id="r2" value="6. Reply goes directly to SNAT/session owner NVA-1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a7f37;strokeWidth=3;endArrow=block;endFill=1;fontSize=14;fontStyle=1;" edge="1" parent="1" source="pe" target="nva1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="735"/></Array></mxGeometry></mxCell>
<mxCell id="r3" value="7. NVA-1 reverse-SNATs and routes reply to client" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a7f37;strokeWidth=3;endArrow=block;endFill=1;fontSize=14;fontStyle=1;" edge="1" parent="1" source="nva1" target="client"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="1080"/><mxPoint x="435" y="1080"/></Array></mxGeometry></mxCell>
<mxCell id="fail" value="Failure / HA behavior&#xa;If NVA-1 fails its probe, the ILB stops assigning new flows to it and sends new flows to healthy NVA-2. Existing sessions are not moved by Azure Load Balancer. Existing-session survival requires vendor-supported state/NAT synchronization or cluster behavior; SNAT design must match the vendor HA model." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#cf222e;fontSize=16;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="45" y="1195" width="2110" height="125" as="geometry"/></mxCell>
<mxCell id="legend" value="Blue = forward path   Green = return path   Purple dashed = control/health   Gray dashed = alternate flow distribution&#xa;Key point: ILB distributes the forward flow; SNAT anchors the PE return flow to the stateful NVA owner." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontSize=14;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="45" y="1330" width="2110" height="45" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>