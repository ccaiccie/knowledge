<mxfile host="app.diagrams.net" modified="2026-09-05T19:45:00.000Z" agent="ChatGPT" version="24.7.17"><diagram id="method2-egress" name="Internet Egress"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Method 2 — Internet egress through a customer-managed hub NVA" style="text;html=1;fontSize=24;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="30" width="1000" height="40" as="geometry"/></mxCell><mxCell id="spoke" value="Spoke A workload&#xa;10.1.1.10&#xa;&#xa;UDR: 0.0.0.0/0 → VirtualAppliance 10.0.1.4" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="340" height="160" as="geometry"/></mxCell><mxCell id="nva" value="Third-party NGFW/NVA&#xa;Inside/data IP 10.0.1.4&#xa;Stateful security policy&#xa;Vendor-specific SNAT/public egress design" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="630" y="280" width="340" height="190" as="geometry"/></mxCell><mxCell id="internet" value="Internet destination&#xa;203.0.113.50:443" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1190" y="320" width="280" height="120" as="geometry"/></mxCell><mxCell id="note" value="The NVA must own or use a supported Azure egress mechanism for SNAT. Do not assume Azure automatically gives the appliance deterministic Internet SNAT. The exact public-IP/LB/NAT design is vendor-specific." style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="450" y="590" width="700" height="100" as="geometry"/></mxCell><mxCell id="e1" value="1 Original: 10.1.1.10:51500 → 203.0.113.50:443" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="spoke" target="nva"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="2 After inspection/SNAT: public-source-IP:translated-port → 203.0.113.50:443" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="nva" target="internet"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="3 Return follows state and reverse NAT through the same NVA" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;dashed=1;" edge="1" parent="1" source="internet" target="nva"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="520"/><mxPoint x="800" y="520"/></Array></mxGeometry></mxCell><mxCell id="e4" value="4 Restored destination 10.1.1.10:51500" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;dashed=1;" edge="1" parent="1" source="nva" target="spoke"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="520"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>