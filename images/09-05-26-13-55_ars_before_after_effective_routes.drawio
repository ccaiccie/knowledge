<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel page="1" pageWidth="1500" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Before and After: What Actually Changes in the Spoke" style="text;html=1;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="n1" value="<b>BEFORE NVA advertises 0/0</b><br/>Route-table resource: empty<br/>NIC effective routes include:<br/>10.20.0.0/16 → VNet/peering<br/>0.0.0.0/0 → Internet<br/>Internet traffic exits normally" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="360" height="220" as="geometry"/></mxCell><mxCell id="n2" value="<b>NVA sends BGP UPDATE</b><br/>NLRI: 0.0.0.0/0<br/>AS_PATH: 65001<br/>Route Server learns it<br/>ARS propagates to eligible spoke" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="170" width="360" height="220" as="geometry"/></mxCell><mxCell id="n3" value="<b>AFTER propagation</b><br/>Route-table resource: still empty<br/>NIC effective routes now include:<br/>0.0.0.0/0 → VirtualAppliance/NVA<br/>Azure selects BGP 0/0 over system 0/0<br/>Packet goes to NVA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1060" y="170" width="360" height="260" as="geometry"/></mxCell><mxCell id="n4" value="<b>If a UDR 0/0 also exists</b><br/>Same-prefix UDR normally wins over BGP<br/>NIC effective route reflects UDR winner<br/>BGP route still exists in control plane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1060" y="520" width="360" height="150" as="geometry"/></mxCell><mxCell id="e1" value="NVA announces" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;dashed=0;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="ARS programs route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;dashed=0;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="UDR can override" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;dashed=1;" edge="1" parent="1" source="n4" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>