<mxfile host="app.diagrams.net"><diagram name="Spoke Ingress Symmetry"><mxGraphModel dx="1700" dy="980" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="980"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Distributed / Spoke Internet Ingress — Local GWLBE Keeps the Return Path Symmetric" style="text;html=1;fontSize=28;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="260" y="20" width="1180" height="45" as="geometry"/></mxCell><mxCell id="legend" value="Forward flow = orange   |   Return flow = blue   |   All ingress/return steering stays in the Application VPC" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#f8fafc;strokeColor=#64748b;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="75" width="980" height="45" as="geometry"/></mxCell><mxCell id="internet" value="Internet Client&#xa;198.51.100.25" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#fef2f2;strokeColor=#dc2626;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="150" height="95" as="geometry"/></mxCell><mxCell id="appvpc" value="Application VPC — AZ-a local data plane" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontStyle=1;verticalAlign=top;spacingTop=12;fillColor=#f8fafc;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="230" y="140" width="1040" height="650" as="geometry"/></mxCell><mxCell id="igw" value="Internet Gateway&#xa;IGW edge route table&#xa;protected subnet → GWLBE-a" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#ecfeff;strokeColor=#0891b2;" vertex="1" parent="1"><mxGeometry x="285" y="240" width="210" height="120" as="geometry"/></mxCell><mxCell id="gwlbe" value="GWLBE-a&#xa;local zonal endpoint&#xa;route-table next hop" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="570" y="240" width="210" height="120" as="geometry"/></mxCell><mxCell id="public" value="Public ALB / NLB / EC2-EIP&#xa;public endpoint in app VPC&#xa;accepted traffic continues to backend" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#fff7ed;strokeColor=#ea580c;" vertex="1" parent="1"><mxGeometry x="905" y="240" width="260" height="120" as="geometry"/></mxCell><mxCell id="backend" value="Backend / target subnet&#xa;10.10.10.20&#xa;return route toward local ingress path" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#f0fdf4;strokeColor=#16a34a;" vertex="1" parent="1"><mxGeometry x="905" y="565" width="260" height="120" as="geometry"/></mxCell><mxCell id="returnrt" value="Return routing inside Application VPC&#xa;public-resource / subnet route table&#xa;0.0.0.0/0 or protected path → GWLBE-a&#xa;No TGW return-AZ reconstruction" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#eef2ff;strokeColor=#4f46e5;" vertex="1" parent="1"><mxGeometry x="520" y="565" width="300" height="135" as="geometry"/></mxCell><mxCell id="securityvpc" value="Security / Service Provider VPC" style="rounded=1;whiteSpace=wrap;html=1;fontSize=21;fontStyle=1;verticalAlign=top;spacingTop=12;fillColor=#fffbeb;strokeColor=#92400e;" vertex="1" parent="1"><mxGeometry x="1320" y="180" width="330" height="430" as="geometry"/></mxCell><mxCell id="gwlb" value="Gateway Load Balancer&#xa;GENEVE / UDP 6081&#xa;flow stickiness" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#fef3c7;strokeColor=#d97706;" vertex="1" parent="1"><mxGeometry x="1370" y="280" width="230" height="105" as="geometry"/></mxCell><mxCell id="ngfw" value="NGFW Fleet&#xa;stateful inspection&#xa;original flow preserved" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#fff7ed;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="1370" y="455" width="230" height="105" as="geometry"/></mxCell><mxCell id="note" value="Why this is simpler than centralized ingress: the packet does not return through TGW into another Ingress VPC. The same application-VPC routing domain selects the local GWLBE on both directions." style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#f0f9ff;strokeColor=#0369a1;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="835" width="1030" height="75" as="geometry"/></mxCell><mxCell id="warning" value="NLB caveat: this local symmetry does NOT make preserve_client_ip supported when the NLB-to-target leg itself traverses a GWLBE. Keep edge inspection (IGW → GWLBE → NLB) distinct from post-NLB inspection." style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#fff1f2;strokeColor=#be123c;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="745" width="830" height="65" as="geometry"/></mxCell><mxCell id="f1" value="1  inbound" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#d97706;endArrow=block;fontSize=14;fontStyle=1;" edge="1" parent="1" source="internet" target="igw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" value="2  IGW edge route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#d97706;endArrow=block;fontSize=14;fontStyle=1;" edge="1" parent="1" source="igw" target="gwlbe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f3" value="3  PrivateLink service chain" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#d97706;endArrow=block;fontSize=14;fontStyle=1;" edge="1" parent="1" source="gwlbe" target="gwlb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="185"/><mxPoint x="1280" y="185"/></Array></mxGeometry></mxCell><mxCell id="f4" value="4  GENEVE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#d97706;endArrow=block;fontSize=14;fontStyle=1;" edge="1" parent="1" source="gwlb" target="ngfw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f5" value="5  allow / return to GWLB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#d97706;endArrow=block;fontSize=14;fontStyle=1;" edge="1" parent="1" source="ngfw" target="gwlb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1630" y="510"/><mxPoint x="1630" y="330"/></Array></mxGeometry></mxCell><mxCell id="f6" value="6  back through GWLBE-a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#d97706;endArrow=block;fontSize=14;fontStyle=1;" edge="1" parent="1" source="gwlb" target="gwlbe"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1280" y="400"/><mxPoint x="840" y="400"/></Array></mxGeometry></mxCell><mxCell id="f7" value="7  to public endpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#d97706;endArrow=block;fontSize=14;fontStyle=1;" edge="1" parent="1" source="gwlbe" target="public"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f8" value="8  LB / resource forwards" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#d97706;endArrow=block;fontSize=14;fontStyle=1;" edge="1" parent="1" source="public" target="backend"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r1" value="9  backend return" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#2563eb;endArrow=block;fontSize=14;fontStyle=1;" edge="1" parent="1" source="backend" target="public"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1210" y="625"/><mxPoint x="1210" y="405"/></Array></mxGeometry></mxCell><mxCell id="r2" value="10  endpoint subnet route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#2563eb;endArrow=block;fontSize=14;fontStyle=1;" edge="1" parent="1" source="public" target="returnrt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="450"/><mxPoint x="850" y="625"/></Array></mxGeometry></mxCell><mxCell id="r3" value="11  select local GWLBE-a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#2563eb;endArrow=block;fontSize=14;fontStyle=1;" edge="1" parent="1" source="returnrt" target="gwlbe"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="625"/><mxPoint x="470" y="420"/></Array></mxGeometry></mxCell><mxCell id="r4" value="12  service chain" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#2563eb;endArrow=block;fontSize=14;fontStyle=1;" edge="1" parent="1" source="gwlbe" target="gwlb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="470"/><mxPoint x="1280" y="470"/></Array></mxGeometry></mxCell><mxCell id="r5" value="13  stateful return" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#2563eb;endArrow=block;fontSize=14;fontStyle=1;" edge="1" parent="1" source="gwlb" target="ngfw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r6" value="14  return through GWLB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#2563eb;endArrow=block;fontSize=14;fontStyle=1;" edge="1" parent="1" source="ngfw" target="gwlb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1640" y="520"/><mxPoint x="1640" y="320"/></Array></mxGeometry></mxCell><mxCell id="r7" value="15  back to GWLBE-a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#2563eb;endArrow=block;fontSize=14;fontStyle=1;" edge="1" parent="1" source="gwlb" target="gwlbe"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1280" y="535"/><mxPoint x="830" y="535"/></Array></mxGeometry></mxCell><mxCell id="r8" value="16  IGW path" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#2563eb;endArrow=block;fontSize=14;fontStyle=1;" edge="1" parent="1" source="gwlbe" target="igw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="510"/><mxPoint x="390" y="510"/></Array></mxGeometry></mxCell><mxCell id="r9" value="17  Internet" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#2563eb;endArrow=block;fontSize=14;fontStyle=1;" 