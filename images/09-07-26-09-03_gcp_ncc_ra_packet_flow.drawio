<mxfile host="app.diagrams.net" modified="2026-09-07T16:03:00.000Z" agent="ChatGPT"><diagram id="ncc-ra-flow" name="Packet Flow"><mxGraphModel dx="1700" dy="1040" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1040"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="East-West Inspection Flow — VM-A 10.10.10.20 → VM-B 10.20.20.20" style="text;html=1;align=center;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="15" width="1100" height="45" as="geometry"/></mxCell>
<mxCell id="vpca" value="VPC-A / 10.10.10.0/24" style="rounded=1;html=1;whiteSpace=wrap;verticalAlign=top;spacingTop=15;spacingLeft=20;fontSize=21;fontStyle=1;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="475" height="760" as="geometry"/></mxCell>
<mxCell id="vma" value="&lt;b&gt;VM-A&lt;/b&gt;&lt;br&gt;10.10.10.20" style="rounded=1;html=1;whiteSpace=wrap;align=center;fontSize=17;fillColor=#ffffff;strokeColor=#5f6368;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="90" y="190" width="390" height="100" as="geometry"/></mxCell>
<mxCell id="rta" value="&lt;b&gt;VPC-A effective route model&lt;/b&gt;&lt;br&gt;&lt;br&gt;10.10.10.0/24 → local subnet route&lt;br&gt;&lt;font color='#d93025'&gt;10.20.20.0/24 → dynamic route&lt;br&gt;next hop: fw-ra-1 nic0 10.10.10.8&lt;/font&gt;&lt;br&gt;&lt;br&gt;Installed from BGP learned by Cloud Router A" style="rounded=1;html=1;whiteSpace=wrap;align=left;spacingLeft=20;fontSize=15;fillColor=#fff7e0;strokeColor=#f9ab00;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="90" y="350" width="390" height="210" as="geometry"/></mxCell>
<mxCell id="cra" value="&lt;b&gt;Cloud Router A — control plane&lt;/b&gt;&lt;br&gt;&lt;br&gt;learns 10.20.20.0/24 from NGFW&lt;br&gt;does not forward VM packets&lt;br&gt;BGP sessions → 10.10.10.8" style="rounded=1;html=1;whiteSpace=wrap;align=center;fontSize=15;fillColor=#fff7e0;strokeColor=#f9ab00;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="90" y="635" width="390" height="150" as="geometry"/></mxCell>
<mxCell id="fw" value="&lt;b&gt;Router Appliance / NGFW — fw-ra-1&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;nic0 / VPC-A&lt;/b&gt; 10.10.10.8     &lt;b&gt;nic1 / VPC-B&lt;/b&gt; 10.20.20.8&lt;br&gt;&lt;br&gt;&lt;b&gt;Firewall forwarding decision&lt;/b&gt;&lt;br&gt;Ingress: nic0&lt;br&gt;Policy: allow/inspect A → B&lt;br&gt;Route: 10.20.20.0/24 reachable via nic1&lt;br&gt;Session state created; no NAT assumed" style="rounded=1;html=1;whiteSpace=wrap;align=center;fontSize=15;fillColor=#fce8e6;strokeColor=#d93025;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="610" y="250" width="480" height="480" as="geometry"/></mxCell>
<mxCell id="vpcb" value="VPC-B / 10.20.20.0/24" style="rounded=1;html=1;whiteSpace=wrap;verticalAlign=top;spacingTop=15;spacingLeft=20;fontSize=21;fontStyle=1;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1175" y="110" width="475" height="760" as="geometry"/></mxCell>
<mxCell id="vmb" value="&lt;b&gt;VM-B&lt;/b&gt;&lt;br&gt;10.20.20.20" style="rounded=1;html=1;whiteSpace=wrap;align=center;fontSize=17;fillColor=#ffffff;strokeColor=#5f6368;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1215" y="190" width="390" height="100" as="geometry"/></mxCell>
<mxCell id="rtb" value="&lt;b&gt;VPC-B effective route model&lt;/b&gt;&lt;br&gt;&lt;br&gt;10.20.20.0/24 → local subnet route&lt;br&gt;&lt;font color='#d93025'&gt;10.10.10.0/24 → dynamic route&lt;br&gt;next hop: fw-ra-1 nic1 10.20.20.8&lt;/font&gt;&lt;br&gt;&lt;br&gt;Installed from BGP learned by Cloud Router B" style="rounded=1;html=1;whiteSpace=wrap;align=left;spacingLeft=20;fontSize=15;fillColor=#fff7e0;strokeColor=#f9ab00;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1215" y="350" width="390" height="210" as="geometry"/></mxCell>
<mxCell id="crb" value="&lt;b&gt;Cloud Router B — control plane&lt;/b&gt;&lt;br&gt;&lt;br&gt;learns 10.10.10.0/24 from NGFW&lt;br&gt;does not forward VM packets&lt;br&gt;BGP sessions → 10.20.20.8" style="rounded=1;html=1;whiteSpace=wrap;align=center;fontSize=15;fillColor=#fff7e0;strokeColor=#f9ab00;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1215" y="635" width="390" height="150" as="geometry"/></mxCell>
<mxCell id="fwd1" value="1 route lookup selects RA next hop" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d93025;strokeWidth=5;endArrow=block;endFill=1;fontColor=#d93025;fontSize=15;" edge="1" parent="1" source="vma" target="fw"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="fwd2" value="2 firewall policy + stateful inspection" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#188038;strokeWidth=5;endArrow=block;endFill=1;fontColor=#188038;fontSize=15;" edge="1" parent="1" source="fw" target="fw"><mxGeometry relative="1" as="geometry"><mxPoint x="835" y="385" as="sourcePoint"/><mxPoint x="865" y="385" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="fwd3" value="3 after inspection → VM-B" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d93025;strokeWidth=5;endArrow=block;endFill=1;fontColor=#d93025;fontSize=15;" edge="1" parent="1" source="fw" target="vmb"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="bgpa" value="BGP advertises B prefix" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a73e8;strokeWidth=3;dashed=1;dashPattern=9 6;endArrow=block;endFill=1;fontColor=#1a73e8;fontSize=14;" edge="1" parent="1" source="cra" target="fw"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="bgpb" value="BGP advertises A prefix" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a73e8;strokeWidth=3;dashed=1;dashPattern=9 6;endArrow=block;endFill=1;fontColor=#1a73e8;fontSize=14;" edge="1" parent="1" source="crb" target="fw"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ret1" value="Return flow: VPC-B learned 10.10.10.0/24 → same firewall path" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d93025;strokeWidth=5;dashed=1;dashPattern=12 8;endArrow=block;endFill=1;fontColor=#d93025;fontSize=14;" edge="1" parent="1" source="vmb" target="fw"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ret2" value="Return → VPC-A (symmetry)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d93025;strokeWidth=5;dashed=1;dashPattern=12 8;endArrow=block;endFill=1;fontColor=#d93025;fontSize=14;" edge="1" parent="1" source="fw" target="vma"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="note" value="&lt;b&gt;Packet fields (no NAT example):&lt;/b&gt; before firewall src 10.10.10.20, dst 10.20.20.20; after firewall unchanged. The NVA changes the forwarding path, not necessarily the IP header.&lt;br&gt;Critical design point: both VPCs must learn the opposite prefix through the appliance. Advertising only one direction produces asymmetric routing or a failed return path." style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="900" width="1560" height="90" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>