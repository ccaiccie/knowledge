<mxfile host="app.diagrams.net" modified="2026-09-07T08:06:00.000Z" agent="ChatGPT" version="24.7.17"><diagram id="nsi-stateful" name="Page-1"><mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Google Cloud NSI — one rule selects the new session; reverse traffic stays intercepted by state" style="text;html=1;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="55" y="15" width="1600" height="50" as="geometry"/></mxCell><mxCell id="client" value="&lt;b&gt;Client VM&lt;/b&gt;&lt;br/&gt;10.10.1.10:51514&lt;br/&gt;Initiates TCP session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#188038;strokeWidth=3;fontSize=16;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="290" height="175" as="geometry"/></mxCell><mxCell id="rule" value="&lt;b&gt;EGRESS intercept rule&lt;/b&gt;&lt;br/&gt;Matches first packet of NEW session&lt;br/&gt;action = APPLY_SECURITY_PROFILE_GROUP&lt;br/&gt;Creates tracked NSI connection state&lt;br/&gt;No duplicate ingress rule needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f29900;strokeWidth=3;fontSize=16;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="450" y="120" width="360" height="235" as="geometry"/></mxCell><mxCell id="nsi" value="&lt;b&gt;NSI / Packet Intercept&lt;/b&gt;&lt;br/&gt;Stateful connection tracking&lt;br/&gt;GENEVE encapsulation&lt;br/&gt;Forward + reverse packets&lt;br/&gt;carry security-profile context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=3;fontSize=16;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="900" y="120" width="330" height="235" as="geometry"/></mxCell><mxCell id="pan" value="&lt;b&gt;VM-Series&lt;/b&gt;&lt;br/&gt;PAN-OS session created&lt;br/&gt;Inspects both directions&lt;br/&gt;Allow → reinject&lt;br/&gt;Deny → drop + log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#d93025;strokeWidth=3;fontSize=16;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1360" y="120" width="330" height="235" as="geometry"/></mxCell><mxCell id="server" value="&lt;b&gt;Server VM&lt;/b&gt;&lt;br/&gt;10.10.2.20:443&lt;br/&gt;Returns SYN-ACK / response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#9334e6;strokeWidth=3;fontSize=16;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1360" y="650" width="330" height="175" as="geometry"/></mxCell><mxCell id="state" value="&lt;b&gt;Existing NSI session state — reverse path&lt;/b&gt;&lt;br/&gt;Google recognizes 10.10.2.20:443 → 10.10.1.10:51514 as the reverse direction of the already tracked connection and intercepts it automatically.&lt;br/&gt;&lt;br/&gt;A separate INGRESS APPLY_SECURITY_PROFILE_GROUP rule is only needed to select a brand-new connection initiated from the opposite direction—not the return leg of this established session." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#5f6368;strokeWidth=3;fontSize=16;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="450" y="615" width="780" height="240" as="geometry"/></mxCell><mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=4;strokeColor=#1a73e8;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="235" as="sourcePoint"/><mxPoint x="450" y="235" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=4;strokeColor=#f29900;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="235" as="sourcePoint"/><mxPoint x="900" y="235" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=4;strokeColor=#1a73e8;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="235" as="sourcePoint"/><mxPoint x="1360" y="235" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e4" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=4;strokeColor=#188038;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1525" y="355" as="sourcePoint"/><mxPoint x="1525" y="650" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e5" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=4;strokeColor=#188038;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="738" as="sourcePoint"/><mxPoint x="1230" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e6" value="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=4;strokeColor=#188038;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="738" as="sourcePoint"/><mxPoint x="810" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e7" value="7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=4;strokeColor=#188038;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="615" as="sourcePoint"/><mxPoint x="1525" y="355" as="targetPoint"/><Array as="points"><mxPoint x="840" y="500"/><mxPoint x="1525" y="500"/></Array></mxGeometry></mxCell><mxCell id="e8" value="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=4;strokeColor=#1a73e8;endArrow=block;endFill=1;dashed=1;dashPattern=8 7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="320" as="sourcePoint"/><mxPoint x="350" y="275" as="targetPoint"/><Array as="points"><mxPoint x="1315" y="420"/><mxPoint x="400" y="420"/></Array></mxGeometry></mxCell><mxCell id="legend" value="1 SYN • 2 new session selected • 3 GENEVE to VM-Series • 4 reinject/deliver • 5 return packet • 6 existing NSI state • 7 automatic reverse interception • 8 inspected response reinjected" style="text;html=1;fontSize=15;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="885" width="1650" height="45" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>