<mxfile host="app.diagrams.net"><diagram name="Example 2: Route Leaking vs Redistribution"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b0" value="&lt;b&gt;Global BGP&lt;/b&gt;&lt;br&gt;Learns 172.16.20.0/24&lt;br&gt;Source protocol = BGP 65000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="45" y="205" width="245" height="150" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;VRF 103 RIB&lt;/b&gt;&lt;br&gt;route-replicate from global&lt;br&gt;Installs replicated prefix&lt;br&gt;Route can forward locally&lt;br&gt;Neighbor still knows nothing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="385" y="150" width="255" height="260" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;VRF 103 OSPF&lt;/b&gt;&lt;br&gt;redistribute vrf global bgp 65000&lt;br&gt;Injects route into OSPF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="735" y="205" width="200" height="150" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;OSPF CE&lt;/b&gt;&lt;br&gt;Receives external route&lt;br&gt;Can reach 172.16.20.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1020" y="205" width="150" height="150" as="geometry"/></mxCell><mxCell id="e0" value="A  RIB route replication" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=4;endArrow=block;endFill=1;fontStyle=1;fontSize=13;" edge="1" parent="1" source="b0" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="B  redistribution" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333ea;strokeWidth=4;endArrow=block;endFill=1;fontStyle=1;fontSize=13;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="C  OSPF advertisement" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=4;endArrow=block;endFill=1;fontStyle=1;fontSize=13;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>