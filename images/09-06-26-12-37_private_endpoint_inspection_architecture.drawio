<mxfile host="app.diagrams.net"><diagram name="Detailed Architecture"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Azure Private Endpoint Inspection — Detailed Hub/Spoke Architecture and Packet Flow" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1350" height="40" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Separate DNS/control-plane, forward-flow, inspection/SNAT, Private Link, and return-flow lanes. Example uses Azure SQL over a Private Endpoint." style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontColor=#57606a;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="65" width="1500" height="30" as="geometry"/></mxCell>
<mxCell id="dnsband" value="DNS / Name Resolution Control Plane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#8c959f;fontSize=20;fontStyle=1;verticalAlign=top;spacingTop=10;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="45" y="115" width="1910" height="170" as="geometry"/></mxCell>
<mxCell id="dnsquery" value="Client DNS Query&#xa;sql1.database.windows.net" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#0969da;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="105" y="178" width="265" height="76" as="geometry"/></mxCell>
<mxCell id="privatedns" value="Private DNS Zone / Resolver Path&#xa;privatelink.database.windows.net&#xa;A record → PE IP 10.20.1.4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#8250df;fontSize=15;" vertex="1" parent="1"><mxGeometry x="735" y="168" width="420" height="94" as="geometry"/></mxCell>
<mxCell id="dnsnote" value="Operational Requirement&#xa;Application uses normal service FQDN.&#xa;Do not validate PE routing while DNS still returns a public endpoint." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#bf8700;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1355" y="168" width="500" height="94" as="geometry"/></mxCell>
<mxCell id="d1" value="D1. Query" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#8250df;strokeWidth=2;endArrow=block;endFill=1;fontSize=15;fontStyle=1;" edge="1" parent="1" source="dnsquery" target="privatedns"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="d2" value="D2. Answer = 10.20.1.4" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#8250df;strokeWidth=2;endArrow=block;endFill=1;fontSize=15;fontStyle=1;" edge="1" parent="1" source="privatedns" target="dnsquery"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="250"/></Array></mxGeometry></mxCell>

<mxCell id="workload" value="Workload Spoke VNet&#xa;10.10.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#8c959f;fontSize=20;fontStyle=1;verticalAlign=top;spacingTop=12;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="45" y="330" width="410" height="725" as="geometry"/></mxCell>
<mxCell id="hub" value="Hub VNet&#xa;10.0.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#bf8700;fontSize=20;fontStyle=1;verticalAlign=top;spacingTop=12;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="515" y="330" width="610" height="725" as="geometry"/></mxCell>
<mxCell id="pevnet" value="Private Endpoint VNet&#xa;10.20.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dafbe1;strokeColor=#1a7f37;fontSize=20;fontStyle=1;verticalAlign=top;spacingTop=12;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="1185" y="330" width="420" height="725" as="geometry"/></mxCell>
<mxCell id="paas" value="Azure PaaS Service&#xa;Example: Azure SQL&#xa;Private Link service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddf4ff;strokeColor=#0969da;fontSize=19;fontStyle=1;verticalAlign=top;spacingTop=18;" vertex="1" parent="1"><mxGeometry x="1665" y="420" width="290" height="520" as="geometry"/></mxCell>

<mxCell id="client" value="Client VM&#xa;10.10.1.4&#xa;App subnet 10.10.1.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#0969da;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="105" y="465" width="285" height="125" as="geometry"/></mxCell>
<mxCell id="rt" value="Route Table: rt-app&#xa;10.20.0.0/16&#xa;Next hop type: VirtualAppliance&#xa;Next hop IP: 10.0.1.4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3cd;strokeColor=#bf8700;fontSize=16;" vertex="1" parent="1"><mxGeometry x="90" y="675" width="315" height="155" as="geometry"/></mxCell>
<mxCell id="effective" value="Effective Route Check&#xa;PE prefix must resolve to&#xa;VirtualAppliance → 10.0.1.4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c959f;fontSize=15;" vertex="1" parent="1"><mxGeometry x="90" y="880" width="315" height="105" as="geometry"/></mxCell>

<mxCell id="fwsubnet" value="AzureFirewallSubnet&#xa;10.0.1.0/26" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bf8700;fontSize=17;fontStyle=1;verticalAlign=top;spacingTop=14;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="565" y="445" width="510" height="315" as="geometry"/></mxCell>
<mxCell id="fw" value="Azure Firewall&#xa;Private IP: 10.0.1.4&#xa;Stateful inspection + policy evaluation&#xa;SNAT creates symmetric PE return path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebe9;strokeColor=#cf222e;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="655" y="530" width="330" height="145" as="geometry"/></mxCell>
<mxCell id="policy" value="Firewall Policy&#xa;Application rule preferred&#xa;when protocol supports it&#xa;Example: SQL TCP/1433" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c959f;fontSize=15;" vertex="1" parent="1"><mxGeometry x="565" y="800" width="230" height="150" as="geometry"/></mxCell>
<mxCell id="state" value="State / NAT Table&#xa;Original:&#xa;10.10.1.4:53000 → 10.20.1.4:1433&#xa;PE-facing:&#xa;10.0.1.4:* → 10.20.1.4:1433" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c959f;fontSize=14;" vertex="1" parent="1"><mxGeometry x="835" y="800" width="240" height="150" as="geometry"/></mxCell>

<mxCell id="pesubnet" value="PE Subnet&#xa;10.20.1.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a7f37;fontSize=17;fontStyle=1;verticalAlign=top;spacingTop=14;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="1235" y="445" width="320" height="345" as="geometry"/></mxCell>
<mxCell id="pe" value="Private Endpoint NIC&#xa;10.20.1.4&#xa;Azure-managed endpoint NIC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcffe4;strokeColor=#1a7f37;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1280" y="555" width="230" height="130" as="geometry"/></mxCell>
<mxCell id="penp" value="Private Endpoint Network Policies&#xa;ENABLED&#xa;Required for UDR / NSG enforcement&#xa;when overriding PE routing behavior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c959f;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1235" y="835" width="320" height="150" as="geometry"/></mxCell>
<mxCell id="sql" value="SQL Service&#xa;Receives traffic through&#xa;Azure Private Link&#xa;No public data path used" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0969da;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1710" y="560" width="200" height="160" as="geometry"/></mxCell>

<mxCell id="peer1" value="VNet peering&#xa;allow forwarded traffic" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#57606a;align=center;" vertex="1" parent="1"><mxGeometry x="445" y="405" width="80" height="50" as="geometry"/></mxCell>
<mxCell id="peer2" value="VNet peering&#xa;hub ↔ PE VNet" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#57606a;align=center;" vertex="1" parent="1"><mxGeometry x="1115" y="405" width="80" height="50" as="geometry"/></mxCell>

<mxCell id="f1" value="1. Route lookup selects UDR&#xa;dst 10.20.1.4 → next hop 10.0.1.4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0969da;strokeWidth=3;endArrow=block;endFill=1;fontSize=14;fontStyle=1;" edge="1" parent="1" source="client" target="fw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="520"/></Array></mxGeometry></mxCell>
<mxCell id="f2" value="2. Firewall allows + SNATs&#xa;source becomes firewall private address" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0969da;strokeWidth=3;endArrow=block;endFill=1;fontSize=14;fontStyle=1;" edge="1" parent="1" source="fw" target="pe"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f3" value="3. Private Link&#xa;PE maps flow to PaaS subresource" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0969da;strokeWidth=3;endArrow=block;endFill=1;fontSize=14;fontStyle=1;" edge="1" parent="1" source="pe" target="sql"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="r1" value="4. Service reply returns through PE" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a7f37;strokeWidth=3;endArrow=block;endFill=1;fontSize=14;fontStyle=1;" edge="1" parent="1" source="sql" target="pe"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1610" y="705"/></Array></mxGeometry></mxCell>
<mxCell id="r2" value="5. Reply targets SNAT owner&#xa;destination = firewall-side translated session" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a7f37;strokeWidth=3;endArrow=block;endFill=1;fontSize=14;fontStyle=1;" edge="1" parent="1" source="pe" target="fw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1170" y="735"/></Array></mxGeometry></mxCell>
<mxCell id="r3" value="6. Reverse SNAT + route to client" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1a7f37;strokeWidth=3;endArrow=block;endFill=1;fontSize=14;fontStyle=1;" edge="1" parent="1" source="fw" target="client"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="735"/></Array></mxGeometry></mxCell>

<mxCell id="legend" value="Blue = forward path     Green = return path     Purple dashed = DNS/control plane&#xa;Key point: SNAT makes the PE-side return path stateful through the firewall. A generic 0.0.0.0/0 route alone does not override a more-specific PE route." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontSize=15;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="45" y="1090" width="1910" height="70" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>