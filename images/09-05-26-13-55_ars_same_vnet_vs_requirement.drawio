<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel page="1" pageWidth="1500" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Common Design: Route Server and NVA in the Same Hub VNet" style="text;html=1;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Hub VNet — simplest pattern&lt;/b&gt;&lt;br/&gt;RouteServerSubnet /26 or larger&lt;br/&gt;Azure Route Server ASN 65515&lt;br/&gt;NVA subnet&lt;br/&gt;NVA peers with both ARS IPs&lt;br/&gt;Spokes peer to this hub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;" vertex="1" parent="1"><mxGeometry x="80" y="170" width="420" height="250" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Spoke VNet&lt;/b&gt;&lt;br/&gt;Workload VM&lt;br/&gt;Uses remote Route Server&lt;br/&gt;Receives NVA BGP routes in effective routes&lt;br/&gt;No BGP process on VM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;" vertex="1" parent="1"><mxGeometry x="610" y="170" width="350" height="250" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Why this pattern is easiest&lt;/b&gt;&lt;br/&gt;BGP reachability is local to hub VNet&lt;br/&gt;Data path to NVA is straightforward&lt;br/&gt;Fewer peering/transit dependencies&lt;br/&gt;Common centralized inspection design" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;" vertex="1" parent="1"><mxGeometry x="1070" y="170" width="350" height="250" as="geometry"/></mxCell><mxCell id="e1" value="VNet peering" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;dashed=0;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Operational model" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;dashed=0;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>