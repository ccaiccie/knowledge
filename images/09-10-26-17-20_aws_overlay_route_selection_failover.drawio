<mxfile host="app.diagrams.net"><diagram name="Route Selection and Failover"><mxGraphModel page="1" pageWidth="1500" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="AWS Overlay Route Selection and Failover" style="text;html=1;align=center;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="800" height="50" as="geometry"/></mxCell><mxCell id="sp" value="Spoke VPC&#xa;10.10.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontSize=18;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="260" height="130" as="geometry"/></mxCell><mxCell id="tgw" value="Transit Gateway&#xa;192.168.0.0/16 → Connect&#xa;192.168.10.0/24 → VPN&#xa;Longest prefix wins" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontSize=17;" vertex="1" parent="1"><mxGeometry x="520" y="145" width="340" height="210" as="geometry"/></mxCell><mxCell id="a" value="Connect Peer A&#xa;BGP path A" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1080" y="110" width="300" height="120" as="geometry"/></mxCell><mxCell id="b" value="Connect Peer B&#xa;BGP path B / failover" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1080" y="300" width="300" height="120" as="geometry"/></mxCell><mxCell id="f" value="Failure chain&#xa;Underlay failure → GRE loss → BGP withdrawal → TGW route change → alternate path&#xa;Reachability convergence does not guarantee application/session continuity." style="rounded=1;whiteSpace=wrap;html=1;align=center;fontSize=18;" vertex="1" parent="1"><mxGeometry x="150" y="570" width="1200" height="180" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="sp" target="tgw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="preferred / ECMP" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="tgw" target="a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="alternate" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="tgw" target="b"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>