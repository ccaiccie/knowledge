<mxfile host="app.diagrams.net"><diagram name="Centralized Ingress ALB Symmetry"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1100"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Centralized Ingress with ALB — How the Return Path Recovers the Original GWLBE" style="text;html=1;fontSize=28;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="1200" height="45" as="geometry"/></mxCell><mxCell id="legend" value="ORANGE = forward backend flow    BLUE = return flow    PURPLE = routing decision / mapping" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;align=center;fillColor=#f8fafc;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="470" y="75" width="860" height="45" as="geometry"/></mxCell><mxCell id="ingress" value="Ingress VPC" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontStyle=1;verticalAlign=top;spacingTop=14;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="180" y="140" width="790" height="800" as="geometry"/></mxCell><mxCell id="aza" value="AZ-a — original ingress / inspection path" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;verticalAlign=top;spacingTop=10;fillColor=#fff7ed;strokeColor=#f97316;dashed=1;" vertex="1" parent="1"><mxGeometry x="220" y="210" width="710" height="270" as="geometry"/></mxCell><mxCell id="azc" value="AZ-c — TGW return re-entry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;verticalAlign=top;spacingTop=10;fillColor=#eff6ff;strokeColor=#3b82f6;dashed=1;" vertex="1" parent="1"><mxGeometry x="220" y="560" width="710" height="310" as="geometry"/></mxCell><mxCell id="client" value="Internet client&#xa;198.51.100.25:53000" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#ffffff;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="140" height="80" as="geometry"/></mxCell><mxCell id="alb" value="Public ALB node — AZ-a&#xa;ALB subnet: 10.255.50.0/24&#xa;Backend source = ALB node private IP" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="285" width="250" height="120" as="geometry"/></mxCell><mxCell id="gwlbea" value="GWLBE-a&#xa;vpce-gwlbe-a&#xa;Original service-chain endpoint" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="285" width="220" height="120" as="geometry"/></mxCell><mxCell id="gwlbec" value="GWLBE-c&#xa;vpce-gwlbe-c&#xa;Local endpoint — NOT selected for this return flow" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;" vertex="1" parent="1"><mxGeometry x="650" y="745" width="235" height="95" as="geometry"/></mxCell><mxCell id="tgwsubnet" value="TGW attachment subnet — AZ-c&#xa;Return packet lands here from TGW" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#eef2ff;strokeColor=#4f46e5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="625" width="245" height="105" as="geometry"/></mxCell><mxCell id="routemap" value="RT-TGW-c route lookup&#xa;&#xa;Destination = ALB-a node IP&#xa;10.255.50.0/24 → GWLBE-a&#xa;&#xa;Therefore return crosses AZ-c → AZ-a" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="545" y="595" width="300" height="135" as="geometry"/></mxCell><mxCell id="security" value="Security VPC / Appliance Service" style="rounded=1;whiteSpace=wrap;html=1;fontSize=21;fontStyle=1;verticalAlign=top;spacingTop=14;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1010" y="200" width="300" height="650" as="geometry"/></mxCell><mxCell id="gwlb" value="Gateway Load Balancer&#xa;+ NGFW fleet&#xa;&#xa;GENEVE UDP/6081&#xa;Stateful inspection" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1050" y="390" width="220" height="150" as="geometry"/></mxCell><mxCell id="tgw" value="AWS Transit Gateway&#xa;&#xa;Forward: sends to App VPC&#xa;Return: may re-enter Ingress VPC through AZ-c attachment subnet" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#ecfeff;strokeColor=#0891b2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1360" y="390" width="220" height="150" as="geometry"/></mxCell><mxCell id="appvpc" value="Application VPC" style="rounded=1;whiteSpace=wrap;html=1;fontSize=21;fontStyle=1;verticalAlign=top;spacingTop=14;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1600" y="200" width="180" height="650" as="geometry"/></mxCell><mxCell id="backend" value="Backend&#xa;10.10.10.20:8443&#xa;&#xa;Return destination =&#xa;ALB-a node private IP" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1620" y="405" width="140" height="135" as="geometry"/></mxCell><mxCell id="forwardLabel" value="FORWARD BACKEND FLOW" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#c2410c;align=left;" vertex="1" parent="1"><mxGeometry x="220" y="160" width="300" height="30" as="geometry"/></mxCell><mxCell id="returnLabel" value="RETURN FLOW — TGW RE-ENTERS INGRESS VPC IN AZ-c" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1d4ed8;align=left;" vertex="1" parent="1"><mxGeometry x="220" y="510" width="520" height="30" as="geometry"/></mxCell><mxCell id="note" value="Key insight: ALB is a proxy. The backend replies to the ALB node, not to the Internet client. That ALB subnet is the deterministic routing key that lets every TGW attachment-subnet route table send the return packet back to the original GWLBE-a." style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;align=center;fillColor=#fff1f2;strokeColor=#be123c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="970" width="1200" height="85" as="geometry"/></mxCell><mxCell id="f0" value="1  Client → ALB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#d97706;fontColor=#c2410c;fontSize=14;endArrow=block;endFill=1;" edge="1" parent="1" source="client" target="alb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f1" value="2  ALB backend flow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#d97706;fontColor=#c2410c;fontSize=14;endArrow=block;endFill=1;" edge="1" parent="1" source="alb" target="gwlbea"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" value="3  GENEVE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#d97706;fontColor=#c2410c;fontSize=14;endArrow=block;endFill=1;" edge="1" parent="1" source="gwlbea" target="gwlb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="345"/><mxPoint x="920" y="440"/></Array></mxGeometry></mxCell><mxCell id="f3" value="4  Inspected flow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#d97706;fontColor=#c2410c;fontSize=14;endArrow=block;endFill=1;" edge="1" parent="1" source="gwlb" target="tgw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f4" value="5  TGW → App VPC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#d97706;fontColor=#c2410c;fontSize=14;endArrow=block;endFill=1;" edge="1" parent="1" source="tgw" target="backend"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r1" value="6  Backend reply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#2563eb;fontColor=#1d4ed8;fontSize=14;endArrow=block;endFill=1;" edge="1" parent="1" source="backend" target="tgw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1690" y="610"/><mxPoint x="1470" y="610"/></Array></mxGeometry></mxCell><mxCell id="r2" value="7  TGW return can land in AZ-c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#2563eb;fontColor=#1d4ed8;fontSize=14;endArrow=block;endFill=1;" edge="1" parent="1" source="tgw" target="tgwsubnet"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1470" y="900"/><mxPoint x="380" y="900"/></Array></mxGeometry></mxCell><mxCell id="r3" value="8  Route lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#7c3aed;fontColor=#6d28d9;fontSize=14;endArrow=block;endFill=1;" edge="1" parent="1" source="tgwsubnet" target="routemap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r4" value="9  Cross-AZ to original GWLBE-a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#2563eb;fontColor=#1d4ed8;fontSize=14;endArrow=block;endFill=1;" edge="1" parent="1" source="routemap" target="gwlbea"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="665"/><mxPoint x="900" y="455"/><mxPoint x="730" y="455"/></Array></mxGeometry></mxCell><mxCell id="r5" value="10  GENEVE / state match" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#2563eb;fontColor=#1d4ed8;fontSize=14;endArrow=block;endFill=1;" edge="1" parent="1" source="gwlbea" target="gwlb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="320"/><mxPoint x="930" y="580"/><mxPoint x="1050" y="580"/></Array></mxGeometry></mxCell><mxCell id="r6" value="11  Return from service chain" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#2563eb;fontColor=#1d4ed8;fontSize=14;endArrow=block;endFill=1;" edge="1" parent="1" source="gwlb" target="gwlbea"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="465"/><mxPoint x="1000" y="250"/><mxPoint x="730" y="250"/></Array></mxGeometry></mxCell><mxCell id="r7" value="12  ALB receives backend response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=4;strokeColor=#2563eb;fontColor=#1d4ed8;fontSize=14;endArrow=block;endFill=1;" edge="1" parent="1" source="gwlbea" target="alb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="430"/><mxPoint x="385" y="430"/></Array></mxGeometry></mxCell><mxCell id="avoid" value="Not this path" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#94a3b8;dashed=1;fontColor=#64748b;fontSize=13;endArrow=open;endFill=0;" edge="1" parent="1" source="tgwsubnet" target="gwlbec"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="795"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>