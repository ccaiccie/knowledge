<mxfile host="app.diagrams.net" modified="2026-09-08T15:07:00.000Z" agent="ChatGPT" version="24.7.17"><diagram id="dx-multi-vif" name="Page-1"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="One physical Direct Connect connection can carry multiple VIFs on unique VLAN tags" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1" vertex="1" parent="1"><mxGeometry x="350" y="30" width="1100" height="50" as="geometry"/></mxCell><mxCell id="router" value="Customer Router&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;DX physical port&lt;br&gt;802.1Q trunk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="70" y="430" width="280" height="170" as="geometry"/></mxCell><mxCell id="dx" value="One Direct Connect&lt;br&gt;physical connection&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;VLAN 100 = Transit VIF&lt;br&gt;VLAN 200 = Public VIF&lt;br&gt;VLAN 300 = Private VIF&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="450" y="390" width="300" height="250" as="geometry"/></mxCell><mxCell id="tvif" value="Transit VIF — VLAN 100&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;BGP session A&lt;br&gt;terminates on DXGW&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="860" y="120" width="320" height="180" as="geometry"/></mxCell><mxCell id="tgw" value="DX Gateway → TGW&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;private hybrid routing&lt;br&gt;VPCs attached to TGW&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1320" y="120" width="340" height="180" as="geometry"/></mxCell><mxCell id="pvif" value="Public VIF — VLAN 200&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;BGP session B&lt;br&gt;AWS public services&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="860" y="455" width="320" height="180" as="geometry"/></mxCell><mxCell id="public" value="AWS Public Prefixes&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;S3 / public AWS endpoints&lt;br&gt;not generic Internet transit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1320" y="455" width="340" height="180" as="geometry"/></mxCell><mxCell id="privvif" value="Private VIF — VLAN 300&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;BGP session C&lt;br&gt;VGW or DXGW private path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="860" y="790" width="320" height="180" as="geometry"/></mxCell><mxCell id="vgw" value="VGW / DXGW&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;private VPC connectivity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1320" y="790" width="340" height="180" as="geometry"/></mxCell><mxCell id="e1" value="single Ethernet handoff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="router" target="dx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="tag 100" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="dx" target="tvif"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="tag 200" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="dx" target="pvif"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="tag 300" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="dx" target="privvif"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="tvif" target="tgw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="pvif" target="public"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="privvif" target="vgw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="VLAN IDs must be unique on the connection (1–4094). Hosted connections normally receive the VLAN from the DX Partner." style="text;html=1;align=center;verticalAlign=middle;fontSize=18" vertex="1" parent="1"><mxGeometry x="400" y="1020" width="1000" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>