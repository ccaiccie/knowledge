<mxfile host="app.diagrams.net" modified="2026-09-05T19:20:00.000Z" agent="ChatGPT" version="24.7.17"><diagram id="route-verification" name="Method 1 Route Verification"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Method 1 Route Verification — Configured UDR → Effective NIC Route → Exact Next Hop" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1450" height="50" as="geometry"/></mxCell>
<mxCell id="udr" value="1. Configured route-table object&#xa;&#xa;RT-SpokeA&#xa;10.20.0.0/16 → VirtualAppliance&#xa;Next-hop IP: 10.0.1.4&#xa;&#xa;az network route-table route list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FF;strokeColor=#0078D4;strokeWidth=3;fontSize=17;fontColor=#24364B;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="430" height="220" as="geometry"/></mxCell>
<mxCell id="effective" value="2. NIC effective route table&#xa;&#xa;Source: User&#xa;State: Active&#xa;10.20.0.0/16 → VirtualAppliance 10.0.1.4&#xa;&#xa;az network nic show-effective-route-table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8661C5;strokeWidth=3;fontSize=17;fontColor=#24364B;" vertex="1" parent="1"><mxGeometry x="585" y="110" width="430" height="220" as="geometry"/></mxCell>
<mxCell id="nexthop" value="3. Exact forwarding proof&#xa;&#xa;Source VM: 10.10.1.10&#xa;Destination: 10.20.1.20&#xa;Result: VirtualAppliance 10.0.1.4&#xa;&#xa;az network watcher show-next-hop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#107C10;strokeWidth=3;fontSize=17;fontColor=#24364B;" vertex="1" parent="1"><mxGeometry x="1110" y="110" width="430" height="220" as="geometry"/></mxCell>
<mxCell id="e1" value="route associated to subnet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0078D4;strokeWidth=4;endArrow=block;fontSize=14;fontColor=#24364B;" edge="1" parent="1" source="udr" target="effective"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="test exact destination" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#107C10;strokeWidth=4;endArrow=block;fontSize=14;fontColor=#24364B;" edge="1" parent="1" source="effective" target="nexthop"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="success" value="SUCCESS — Azure Firewall is inline for 10.20.1.20&#xa;&#xa;Configured UDR: 10.20.0.0/16 → 10.0.1.4&#xa;Effective route: User / Active / VirtualAppliance&#xa;Next-hop result: VirtualAppliance / 10.0.1.4&#xa;&#xa;Packet path: Spoke A → Azure Firewall → Spoke B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#107C10;strokeWidth=3;fontSize=18;fontColor=#24364B;" vertex="1" parent="1"><mxGeometry x="95" y="420" width="650" height="320" as="geometry"/></mxCell>
<mxCell id="failure" value="FAILURE — a more-specific/direct route bypasses firewall&#xa;&#xa;Example: Default / Active / 10.20.0.0/16 → VNetPeering&#xa;&#xa;or: BGP / Active / 172.16.0.0/16 → VirtualNetworkGateway&#xa;&#xa;Meaning: the packet never reaches Azure Firewall.&#xa;Action: fix prefix/UDR/association/propagation and retest." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#D13438;strokeWidth=3;fontSize=18;fontColor=#24364B;" vertex="1" parent="1"><mxGeometry x="855" y="420" width="650" height="320" as="geometry"/></mxCell>
<mxCell id="note" value="Operational rule: configured routes show intent; effective routes show installed state; show-next-hop proves the selected path for one destination." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#7A869A;strokeWidth=2;fontSize=17;fontColor=#24364B;" vertex="1" parent="1"><mxGeometry x="170" y="800" width="1260" height="60" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>