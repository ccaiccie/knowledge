<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel page="1" pageWidth="1500" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="ExpressRoute inspection caveat" style="text;html=1;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="a" value="&lt;b&gt;On-premises&lt;/b&gt;&lt;br&gt;10.100.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="250" height="120" as="geometry"/></mxCell><mxCell id="b" value="&lt;b&gt;ExpressRoute Gateway&lt;/b&gt;&lt;br&gt;GatewaySubnet&lt;br&gt;Directly knows ER-learned prefixes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;" vertex="1" parent="1"><mxGeometry x="420" y="180" width="280" height="120" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;NVA / Firewall&lt;/b&gt;&lt;br&gt;Inspection only if its route wins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f59e0b;" vertex="1" parent="1"><mxGeometry x="790" y="180" width="260" height="120" as="geometry"/></mxCell><mxCell id="d" value="&lt;b&gt;Spoke VM&lt;/b&gt;&lt;br&gt;Effective route selects next hop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;" vertex="1" parent="1"><mxGeometry x="1140" y="180" width="260" height="120" as="geometry"/></mxCell><mxCell id="e" value="&lt;b&gt;Azure Route Server&lt;/b&gt;&lt;br&gt;Branch-to-branch shares routes between ER gateway and NVA.&lt;br&gt;Route exchange does not automatically force service chaining.&lt;br&gt;More-specific ER routes can beat an NVA default." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;" vertex="1" parent="1"><mxGeometry x="470" y="470" width="560" height="170" as="geometry"/></mxCell><mxCell id="e1" value="ER ingress" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="only if route steers to NVA" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="inspected delivery" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="c" target="d"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>