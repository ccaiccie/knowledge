<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel page="1" pageWidth="1500" pageHeight="630"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="ExpressRoute + Azure Route Server: dynamic NVA route exchange" style="text;html=1;fontSize=26;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="15" width="900" height="45" as="geometry"/></mxCell><mxCell id="on" value="&lt;b&gt;On-premises WAN&lt;/b&gt;&lt;br&gt;10.10.0.0/16" style="rounded=1;html=1;fillColor=#F1F8EE;strokeColor=#107C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="50" y="245" width="240" height="110" as="geometry"/></mxCell><mxCell id="er" value="&lt;b&gt;ExpressRoute circuit&lt;/b&gt;&lt;br&gt;Private peering" style="rounded=1;html=1;fillColor=#FFF5EE;strokeColor=#D83B01;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="360" y="245" width="250" height="110" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;ExpressRoute VNet gateway&lt;/b&gt;&lt;br&gt;GatewaySubnet" style="rounded=1;html=1;fillColor=#EAF4FB;strokeColor=#0078D4;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="700" y="135" width="300" height="120" as="geometry"/></mxCell><mxCell id="ars" value="&lt;b&gt;Azure Route Server&lt;/b&gt;&lt;br&gt;RouteServerSubnet • ASN 65515" style="rounded=1;html=1;fillColor=#F4F1FF;strokeColor=#6B4EFF;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="700" y="390" width="300" height="120" as="geometry"/></mxCell><mxCell id="nva" value="&lt;b&gt;NVA / SD-WAN appliance&lt;/b&gt;&lt;br&gt;BGP peer ASN 65050" style="rounded=1;html=1;fillColor=#FFF5EE;strokeColor=#D83B01;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1110" y="390" width="300" height="120" as="geometry"/></mxCell><mxCell id="v" value="&lt;b&gt;Hub / spoke VNets&lt;/b&gt;&lt;br&gt;Azure workload routes" style="rounded=1;html=1;fillColor=#EAF4FB;strokeColor=#0078D4;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1110" y="135" width="300" height="120" as="geometry"/></mxCell><mxCell id="e1" value="eBGP" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#107C10;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="on" target="er"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Private peering" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0078D4;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="er" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Route exchange" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6B4EFF;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="gw" target="ars"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="BGP to both ARS IPs" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6B4EFF;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="ars" target="nva"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="VNet / NVA routes" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0078D4;strokeWidth=4;dashed=1;endArrow=block;" edge="1" parent="1" source="ars" target="v"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n" value="Enable branch-to-branch route exchange when ER/VPN gateways must exchange routes with NVAs. ARS is not circuit-to-circuit transit." style="rounded=1;html=1;fillColor=#FFFBEA;strokeColor=#E6C84F;" vertex="1" parent="1"><mxGeometry x="340" y="555" width="820" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>