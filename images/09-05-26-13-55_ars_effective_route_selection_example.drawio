<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel page="1" pageWidth="1500" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Minute Route-Selection Example on a Spoke NIC" style="text;html=1;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="n1" value="<b>System routes</b><br/>10.20.0.0/16 → VNet peering<br/>0.0.0.0/0 → Internet<br/>Created by Azure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="300" height="210" as="geometry"/></mxCell><mxCell id="n2" value="<b>BGP via Route Server</b><br/>0.0.0.0/0 → 10.0.2.4<br/>10.100.0.0/16 → 10.0.2.4<br/>Dynamically learned from NVA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="160" width="300" height="210" as="geometry"/></mxCell><mxCell id="n3" value="<b>Optional UDRs</b><br/>203.0.113.0/24 → Internet<br/>10.100.10.0/24 → 10.0.2.5<br/>Configured by administrator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="300" height="210" as="geometry"/></mxCell><mxCell id="n4" value="<b>Effective route selection</b><br/>Step 1: longest prefix wins<br/>Step 2: if same prefix, source precedence<br/>Result varies by destination<br/>This is what NIC uses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1170" y="150" width="270" height="240" as="geometry"/></mxCell><mxCell id="n5" value="<b>Example packet decisions</b><br/>8.8.8.8 → matches 0/0; NVA BGP default beats system Internet default<br/>10.100.50.25 → matches BGP 10.100.0.0/16; goes to NVA<br/>10.100.10.50 → matches UDR /24; UDR wins by longer prefix<br/>203.0.113.25 → matches UDR /24; explicit exception bypasses NVA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="520" width="1000" height="170" as="geometry"/></mxCell><mxCell id="e1" value="Candidate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;dashed=0;" edge="1" parent="1" source="n1" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Candidate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;dashed=0;" edge="1" parent="1" source="n2" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Candidate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;dashed=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Selected next hop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;dashed=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>