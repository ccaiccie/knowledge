<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel page="1" pageWidth="1500" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="How an NVA Route Reaches a Spoke VM" style="text;html=1;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="n1" value="<b>NVA BGP RIB</b><br/>Advertises: 0.0.0.0/0<br/>NEXT_HOP = NVA private IP<br/>AS_PATH = 65001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="260" height="150" as="geometry"/></mxCell><mxCell id="n2" value="<b>Azure Route Server</b><br/>Learns route over eBGP<br/>Applies route-map policy if configured<br/>Keeps route in ARS control plane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="180" width="270" height="150" as="geometry"/></mxCell><mxCell id="n3" value="<b>Azure SDN route propagation</b><br/>Evaluates peering eligibility<br/>Propagates learned route to hub/spoke<br/>Does NOT edit a UDR resource" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="180" width="300" height="150" as="geometry"/></mxCell><mxCell id="n4" value="<b>Spoke VM NIC effective routes</b><br/>System routes<br/>BGP route: 0.0.0.0/0 → NVA<br/>Any UDRs attached to subnet<br/>Azure selects winning route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1140" y="160" width="300" height="190" as="geometry"/></mxCell><mxCell id="n5" value="<b>Subnet Route Table resource</b><br/>May contain zero UDR entries<br/>Remains unchanged by NVA BGP<br/>Only static/admin-defined UDRs live here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1140" y="500" width="300" height="150" as="geometry"/></mxCell><mxCell id="e1" value="1. UPDATE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;dashed=1;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="2. Learned route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;dashed=1;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="3. Program effective route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;dashed=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="UDR contributes if present" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;dashed=1;" edge="1" parent="1" source="n5" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>