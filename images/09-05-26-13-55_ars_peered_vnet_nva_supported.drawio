<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel page="1" pageWidth="1400" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Pattern 2 — NVA in a Different Peered VNet" style="text;html=1;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell><mxCell id="a" value="&lt;b&gt;VNet A — Route Server VNet&lt;/b&gt;&lt;br/&gt;RouteServerSubnet&lt;br/&gt;Azure Route Server&lt;br/&gt;ASN 65515&lt;br/&gt;Two managed BGP IPs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="360" height="260" as="geometry"/></mxCell><mxCell id="b" value="&lt;b&gt;VNet B — NVA VNet&lt;/b&gt;&lt;br/&gt;NVA 10.50.2.4&lt;br/&gt;ASN 65001&lt;br/&gt;Peers to both ARS IPs&lt;br/&gt;TCP/179 reachable over peering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;" vertex="1" parent="1"><mxGeometry x="520" y="160" width="360" height="260" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;Workload VNet / Spoke&lt;/b&gt;&lt;br/&gt;Consumes remote Route Server routes&lt;br/&gt;Must have valid path to NVA&lt;br/&gt;Peering is not automatically transitive&lt;br/&gt;Route propagation ≠ packet transit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f59e0b;" vertex="1" parent="1"><mxGeometry x="1000" y="160" width="340" height="260" as="geometry"/></mxCell><mxCell id="e1" value="Peering + BGP" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;dashed=1;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Valid data path required" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>