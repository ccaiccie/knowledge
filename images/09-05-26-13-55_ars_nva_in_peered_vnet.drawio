<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel page="1" pageWidth="1500" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Supported Concept: Route Server and NVA in Different Peered VNets" style="text;html=1;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;VNet A — Route Server VNet&lt;/b&gt;&lt;br/&gt;RouteServerSubnet&lt;br/&gt;ARS peer IP 1 + peer IP 2&lt;br/&gt;ASN 65515&lt;br/&gt;VNet peering to NVA hub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="380" height="240" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;VNet B — NVA Hub&lt;/b&gt;&lt;br/&gt;Third-party NVA&lt;br/&gt;Private IP reachable across peering&lt;br/&gt;BGP to both ARS peer IPs&lt;br/&gt;ASN different from 65515" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="380" height="240" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Workload VNet / spoke&lt;/b&gt;&lt;br/&gt;Must have a valid route-distribution relationship&lt;br/&gt;Must also have a real data path to NVA&lt;br/&gt;Peering is not automatically transitive&lt;br/&gt;Effective route alone does not create transit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;" vertex="1" parent="1"><mxGeometry x="1060" y="150" width="380" height="240" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Two independent questions&lt;/b&gt;&lt;br/&gt;CONTROL PLANE: Can NVA TCP/179 reach both Route Server BGP IPs and exchange routes?&lt;br/&gt;DATA PLANE: Can a workload packet actually reach the NVA next-hop IP and then the destination?&lt;br/&gt;Both must be true. Route Server does not forward packets and VNet peering is not transitive by default." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;" vertex="1" parent="1"><mxGeometry x="310" y="520" width="880" height="160" as="geometry"/></mxCell><mxCell id="e1" value="VNet peering + BGP" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;dashed=1;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Explicit connectivity required" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;dashed=0;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>