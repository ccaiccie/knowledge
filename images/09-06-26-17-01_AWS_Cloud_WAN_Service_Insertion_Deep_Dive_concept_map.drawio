<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1100"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Distributed GWLBE&lt;/b&gt;&lt;br/&gt;GWLBE = Gateway Load Balancer Endpoint&lt;br/&gt;Endpoint close to workload/edge&lt;br/&gt;VPC route table steers to GWLBE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4ff;strokeColor=#3b82f6;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="275" height="150" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;Centralized GWLBE&lt;/b&gt;&lt;br/&gt;Shared Inspection VPC&lt;br/&gt;GWLBE/GWLB/firewall fleet centralized&lt;br/&gt;TGW or Cloud WAN gets traffic there" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4ff;strokeColor=#3b82f6;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="275" height="155" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;Service-Insertion Idea&lt;/b&gt;&lt;br/&gt;DMZ / policy-routing concept&lt;br/&gt;Before A reaches B, go through firewall&lt;br/&gt;Routing intent, not the firewall&lt;br/&gt;Cloud WAN automates WAN steering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#ff9900;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="400" y="285" width="315" height="245" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;AWS Cloud WAN&lt;/b&gt;&lt;br/&gt;CNE = Core Network Edge&lt;br/&gt;Segment = VRF-like routing domain&lt;br/&gt;NFG = Network Function Group&lt;br/&gt;send-via = attachment-to-attachment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="820" y="135" width="350" height="180" as="geometry"/></mxCell><mxCell id="6" value="&lt;b&gt;Inspection VPC&lt;/b&gt;&lt;br/&gt;GWLBE = Gateway Load Balancer Endpoint&lt;br/&gt;GWLB = Gateway Load Balancer&lt;br/&gt;NGFW = Next-Generation Firewall&lt;br/&gt;or AWS Network Firewall" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eefbf3;strokeColor=#16a34a;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="820" y="500" width="350" height="180" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;Result&lt;/b&gt;&lt;br/&gt;Cloud WAN chooses inspection attachment&lt;br/&gt;VPC routes choose firewall endpoint&lt;br/&gt;Firewall applies security policy&lt;br/&gt;Return path remains symmetric" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f1ff;strokeColor=#7c3aed;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1280" y="285" width="350" height="225" as="geometry"/></mxCell><mxCell id="8" value="same security goal" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563eb;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="2" target="4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="9" value="same security goal" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563eb;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="10" value="Cloud WAN expresses intent" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ea580c;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" value="NFG sends to inspection" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#dc2626;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12" value="inspected packet" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16a34a;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>