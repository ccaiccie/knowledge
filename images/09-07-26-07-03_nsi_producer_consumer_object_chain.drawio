<mxfile host="app.diagrams.net" modified="2026-09-07T22:00:00.000Z" agent="ChatGPT" version="24.7.17"><diagram id="nsi-chain" name="NSI Producer Consumer Chain"><mxGraphModel page="1" pageWidth="1800" pageHeight="1100" grid="1" gridSize="10"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Google Cloud NSI in-band: how producer and consumer objects tie together" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="30" width="940" height="70" as="geometry"/></mxCell><mxCell id="consumerLane" value="CONSUMER PROJECT — app-prod-1" style="swimlane;html=1;rounded=1;horizontal=1;startSize=40;fillColor=#f3f8ff;strokeColor=#1a73e8;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="1660" height="360" as="geometry"/></mxCell><mxCell id="producerLane" value="PRODUCER PROJECT — pan-sec-prod" style="swimlane;html=1;rounded=1;horizontal=1;startSize=40;fillColor=#fff8f1;strokeColor=#f29900;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="560" width="1660" height="430" as="geometry"/></mxCell><mxCell id="vm" value="Workload VM&#xa;10.10.1.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;fontSize=15;" vertex="1" parent="1"><mxGeometry x="110" y="260" width="170" height="80" as="geometry"/></mxCell><mxCell id="rule" value="Firewall policy rule&#xa;APPLY_SECURITY_PROFILE_GROUP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d2e3fc;strokeColor=#1a73e8;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="240" width="230" height="120" as="geometry"/></mxCell><mxCell id="spg" value="Security profile group&#xa;pan-spg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="610" y="250" width="190" height="100" as="geometry"/></mxCell><mxCell id="profile" value="Custom-intercept profile&#xa;pa