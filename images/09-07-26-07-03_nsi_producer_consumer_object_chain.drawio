ll><mxCell id="fr" value="Internal forwarding rule&#xa;pan-nsi-ilb-fr&#xa;regional UDP/6081 frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#ea4335;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="650" width="220" height="130" as="geometry"/></mxCell><mxCell id="bs" value="Backend service&#xa;pan-nsi-ilb-bs&#xa;regional INTERNAL / UDP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;fontSize=14;" vertex="1" parent="1"><mxGeometry x="230" y="650" width="190" height="130" as="geometry"/></mxCell><mxCell id="fw" value="VM-Series instance group&#xa;healthy firewall backends&#xa;GENEVE inspection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="830" width="260" height="110" as="geometry"/></mxCell><mxCell id="note" value="CONTROL / REFERENCE CHAIN: consumer selects producer service by object references.&#xa;DATA PATH after rule match: NSI selects a zonal deployment → forwarding rule → backend service → healthy VM-Series → verdict/reinjection." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="850" width="540" height="100" as="geometry"/></mxCell><mxCell id="e1" value="1. packet" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#1a73e8;fontSize=12;" edge="1" parent="1" source="vm" target="rule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="2. rule references" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1a73e8;fontSize=12;" edge="1" parent="1" source="rule" target="spg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="3. contains" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1a73e8;fontSize=12;" edge