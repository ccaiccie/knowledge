<mxfile host="app.diagrams.net" modified="2026-09-05T19:45:00.000Z" agent="ChatGPT" version="24.7.17"><diagram id="method2-ha" name="HA Ports"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Method 2 — Highly available NVA pair behind one Internal Standard Load Balancer" style="text;html=1;fontSize=24;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1100" height="40" as="geometry"/></mxCell><mxCell id="spoke" value="Spoke workload subnet&#xa;10.1.1.0/24&#xa;&#xa;UDR: 0.0.0.0/0 → VirtualAppliance 10.0.1.10" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="350" height="160" as="geometry"/></mxCell><mxCell id="ilb" value="Internal Standard Load Balancer&#xa;HA Ports frontend VIP: 10.0.1.10&#xa;Protocol: All / ports: 0&#xa;Health probe selects healthy backends" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="280" width="400" height="190" as="geometry"/></mxCell><mxCell id="nva1" value="NVA-1&#xa;10.0.1.4&#xa;Backend pool" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1160" y="180" width="260" height="120" as="geometry"/></mxCell><mxCell id="nva2" value="NVA-2&#xa;10.0.1.5&#xa;Backend pool" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1160" y="500" width="260" height="120" as="geometry"/></mxCell><mxCell id="internet" value="Internet / remote destination" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1170" y="350" width="250" height="80" as="geometry"/></mxCell><mxCell id="note" value="Flow symmetry is guaranteed only for supported single-ILB/single-backend-pool HA-Ports