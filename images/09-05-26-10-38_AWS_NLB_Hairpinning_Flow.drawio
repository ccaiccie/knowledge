<mxfile host="app.diagrams.net" modified="2026-09-05T17:45:00.000Z" agent="ChatGPT" version="24.7.17">
  <diagram id="aws-nlb-hairpin" name="NLB Hairpinning">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="AWS NLB Hairpinning: Why Client-IP Preservation Must Be Disabled" style="text;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="1100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="client" value="Original Client&#xa;192.0.2.50" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="180" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="nlb" value="Internal Network Load Balancer&#xa;(NLB)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="610" y="165" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="proxyA" value="Proxy-A / Target&#xa;10.0.1.10&#xa;&#xa;Also calls the same NLB" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1080" y="110" width="240" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="proxyB" value="Proxy-B / Target&#xa;10.0.2.10" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1080" y="330" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="bad" value="BAD PATH WITH CLIENT-IP PRESERVATION&#xa;&#xa;If Proxy-A calls the NLB and the NLB selects Proxy-A again:&#xa;SRC = 10.0.1.10&#xa;DST = 10.0.1.10&#xa;&#xa;AWS NAT loopback / hairpinning is unsupported in this mode." style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="520" width="480" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="good" value="GOOD DESIGN&#xa;&#xa;1. Disable client-IP preservation&#xa;2. NLB private IP becomes the network-layer source seen by the target&#xa;3. Enable Proxy Protocol v2 (PPv2)&#xa;4. Application reads original client identity from PPv2 metadata" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="850" y="520" width="500" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="TCP request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="client" target="nlb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="Load-balanced connection" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="nlb" target="proxyA">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="Load-balanced connection" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="nlb" target="proxyB">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="hairpin" value="Hairpin call: Proxy-A → same NLB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;endArrow=block;endFill=1;strokeWidth=2;dashed=1;" edge="1" parent="1" source="proxyA" target="nlb">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="980" y="75"/>
              <mxPoint x="740" y="75"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note" value="PPv2 carries the original source IP/port as metadata after client-IP preservation is disabled." style="text;html=1;fontSize=15;fontStyle=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="535" y="350" width="430" height="90" as="geometry"/>
        </mxCell>
      </root>
