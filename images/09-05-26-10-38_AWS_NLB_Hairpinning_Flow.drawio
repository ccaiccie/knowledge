        <mxCell id="hairpin" value="③ HAIRPIN: Proxy-A → same NLB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#FF5A5F;strokeWidth=5;dashed=1;dashPattern=8 6;fontColor=#FF8085;fontStyle=1;endArrow=block;endFill=1;" edge="1" parent="1" source="proxyA" target="nlb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="150"/><mxPoint x="785" y="150"/></Array></mxGeometry></mxCell>
        <mxCell id="bad" value="✕  BAD: Client-IP preservation enabled&#xa;&#xa;If Proxy-A calls the NLB and NLB selects Proxy-A:&#xa;SRC = 10.0.1.10   DST = 10.0.1.10&#xa;&#xa;AWS NAT loopback / hairpinning is unsupported in this mode." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#450A0A;gradientColor=#7F1D1D;strokeColor=#FF5A5F;strokeWidth=3;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacing=20;" vertex="1" parent="1"><mxGeometry x="65" y="675" width="700" height="240" as="geometry"/></mxCell>
        <mxCell id="good" value="✓  GOOD: Disable preservation + use PPv2&#xa;&#xa;1. Disable client-IP preservation.&#xa;2. Target sees NLB private IP at Layer 3.&#xa;3. Enable Proxy Protocol v2 after backend supports it.&#xa;4. Recover original client IP/port from PPv2 metadata." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#134E4A;gradientColor=#0F766E;strokeColor=#34D399;strokeWidth=3;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacing=20;" vertex="1" parent="1"><mxGeometry x="835" y="675" width="700" height="240" as="geometry"/></mxCell>
