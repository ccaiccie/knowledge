        <mxCell id="client" value="CLIENT&#xa;192.0.2.50" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F80ED;gradientColor=#56CCF2;strokeColor=#8BD8FF;strokeWidth=2;fontColor=#FFFFFF;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="265" width="180" height="170" as="geometry"/></mxCell>
        <mxCell id="nlb" value="⚖&#xa;NETWORK LOAD BALANCER&#xa;Internal NLB · TCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B21A8;gradientColor=#B46CFF;strokeColor=#D8B4FE;strokeWidth=3;fontColor=#FFFFFF;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="225" width="320" height="210" as="geometry"/></mxCell>
        <mxCell id="proxyA" value="▣  Proxy-A&#xa;EC2 target&#xa;10.0.1.10&#xa;&#xa;ALSO CALLS NLB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2A2115;strokeColor=#ED7100;strokeWidth=3;fontColor=#FFFFFF;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="190" width="300" height="180" as="geometry"/></mxCell>
        <mxCell id="proxyB" value="▣  Proxy-B&#xa;EC2 target&#xa;10.0.2.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2A2115;strokeColor=#ED7100;strokeWidth=3;fontColor=#FFFFFF;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="410" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="e1" value="① TCP connection" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E5E7EB;strokeWidth=4;fontColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;" edge="1" parent="1" source="client" target="nlb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="② target selection" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E5E7EB;strokeWidth=4;fontColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;" edge="1" parent="1" source="nlb" target="proxyA"><mxGeometry relative="1" as="geometry"/></mxCell>
