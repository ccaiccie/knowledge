        <mxCell id="title" value="AWS NLB Hairpinning &amp; Client Identity" style="text;html=1;fontSize=30;fontStyle=1;fontColor=#FFFFFF;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="25" width="1000" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Why client-IP preservation breaks NAT loopback — and where Proxy Protocol v2 fits" style="text;html=1;fontSize=16;fontColor=#CBD5E1;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="1000" height="30" as="geometry"/></mxCell>
