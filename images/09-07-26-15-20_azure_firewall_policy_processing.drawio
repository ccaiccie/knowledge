  <diagram id="azure-fw-policy-processing" name="Page-1">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Azure Firewall Policy processing order" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="600" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Rule type controls the major processing pass; numeric priorities order groups/collections within each pass." style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="300" y="65" width="800" height="30" as="geometry"/></mxCell>
        <mxCell id="packet" value="&lt;b&gt;Packet reaches Azure Firewall&lt;/b&gt;&lt;br&gt;Routing / Routing Intent already selected the firewall" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fillColor=#f5f5f5;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="490" y="125" width="420" height="85" as="geometry"/></mxCell>
        <mxCell id="ti" value="&lt;b&gt;1. Threat Intelligence&lt;/b&gt;&lt;br&gt;Highest priority when enabled; Alert / Deny behavior" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fillColor=#fff7e6;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="490" y="260" width="420" height="85" as="geometry"/></mxCell>
        <mxCell id="dnat" value="&lt;b&gt;2. DNAT pass&lt;/b&gt;&lt;br&gt;RCGs by priority&lt;br&gt;Collections by priority&lt;br&gt;Match translates + allows" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fillColor=#fdecec;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="120" y="405" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="network" value="&lt;b&gt;3. Network pass&lt;/b&gt;&lt;br&gt;RCGs by priority&lt;br&gt;Collections by priority&lt;br&gt;IP / protocol / port match" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fillColor=#eaf3ff;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="535" y="405" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="app" value="&lt;b&gt;4. Application pass&lt;/b&gt;&lt;br&gt;RCGs by priority&lt;br&gt;Collections by priority&lt;br&gt;HTTP/S FQDN / URL controls" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fillColor=#eef9ee;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="950" y="405" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="nomatch" value="&lt;b&gt;No allow match&lt;/b&gt;&lt;br&gt;Infrastructure processing where applicable" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fillColor=#f5f5f5;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="535" y="635" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="deny" value="&lt;b&gt;Implicit deny&lt;/b&gt;&lt;br&gt;Traffic not explicitly permitted is denied" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=19;fillColor=#ededed;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="535" y="810" width="330" height="85" as="geometry"/></mxCell>
        <mxCell id="priority" value="&lt;b&gt;Priority rule&lt;/b&gt;&lt;br&gt;Within each rule-type pass:&lt;br&gt;1. Parent policy before child policy&lt;br&gt;2. RCG lower number first&lt;br&gt;3. Collection lower number first" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fillColor=#ffffff;strokeColor=#777777;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="635" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="terminate" value="&lt;b&gt;Terminating behavior&lt;/b&gt;&lt;br&gt;A matching network rule prevents later application-rule evaluation.&lt;br&gt;&lt;br&gt;A matching DNAT rule translates and allows the inbound connection." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fillColor=#ffffff;strokeColor=#777777;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="970" y="635" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="packet" target="ti"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="ti" target="dnat"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="370"/><mxPoint x="285" y="370"/></Array></mxGeometry></mxCell>
        <mxCell id="e3" value="no DNAT match" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;fontSize=14;" edge="1" parent="1" source="dnat" target="network"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="no network match" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;fontSize=14;" edge="1" parent="1" source="network" target="app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="app" target="nomatch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1115" y="580"/><mxPoint x="700" y="580"/></Array></mxGeometry></mxCell>
        <mxCell id="e6" value="still unmatched" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;fontSize=14;" edge="1" parent="1" source="nomatch" target="deny"><mxGeometry relative="1" as="geometry"/></mxCell>
