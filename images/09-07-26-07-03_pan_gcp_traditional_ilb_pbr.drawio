<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Traditional VM-Series service insertion — internal passthrough LB + PBR/custom routes" style="text;html=1;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1450" height="50" as="geometry"/></mxCell><mxCell id="a" value="&lt;b&gt;Workload VPC A&lt;/b&gt;&lt;br/&gt;10.10.0.0/16&lt;br/&gt;workload-a 10.10.1.10&lt;br/&gt;PBR/custom route → ILB A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="280" height="190" as="geometry"/></mxCell><mxCell id="l" value="&lt;b&gt;Internal passthrough NLB A&lt;/b&gt;&lt;br/&gt;Frontend 10.10.0.10&lt;br/&gt;Backends: VM-Series NICs&lt;br/&gt;Health checks select backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#188038;fontSize=15;" vertex="1" parent="1"><mxGeometry x="390" y="150" width="300" height="190" as="geometry"/></mxCell><mxCell id="f" value="&lt;b&gt;VM-Series firewall pair/fleet&lt;/b&gt;&lt;br/&gt;Multi-NIC PAN-OS VMs&lt;br/&gt;NIC0/load-balancer constraints&lt;br/&gt;NICs fixed at VM creation&lt;br/&gt;Security/NAT policy + virtual router&lt;br/&gt;Active/passive or autoscale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#d93025;fontSize=15;" vertex="1" parent="1"><mxGeometry x="790" y="120" width="320" height="240" as="geometry"/></mxCell><mxCell id="b" value="&lt;b&gt;Workload VPC B&lt;/b&gt;&lt;br/&gt;10.20.0.0/16&lt;br/&gt;workload-b 10.20.1.20&lt;br/&gt;Return → ILB B for symmetry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1210" y="150" width="290" height="190" as="geometry"/></mxCell><mxCell id="i" value="&lt;b&gt;Internet / external LB&lt;/b&gt;&lt;br/&gt;External LB can front VM-Series&lt;br/&gt;Outbound uses firewall untrust path&lt;br/&gt;Cloud NAT/external IP by design" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f29900;fontSize=15;" vertex="1" parent="1"><mxGeometry x="790" y="520" width="320" height="170" as="geometry"/></mxCell><mxCell id="e1" value="1 steer" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1a73e8;strokeWidth=4;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="245" as="sourcePoint"/><mxPoint x="390" y="245" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" value="2 healthy firewall" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#188038;strokeWidth=4;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="245" as="sourcePoint"/><mxPoint x="790" y="245" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3" value="3 forward" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d93025;strokeWidth=4;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110" y="245" as="sourcePoint"/><mxPoint x="1210" y="245" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e4" value="4 return via corresponding ILB" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#188038;strokeWidth=4;dashed=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1210" y="300" as="sourcePoint"/><mxPoint x="690" y="300" as="targetPoint"/><Array as="points"><mxPoint x="1160" y="410"/><mxPoint x="700" y="410"/></Array></mxGeometry></mxCell><mxCell id="e5" value="north/south" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#f29900;strokeWidth=4;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="360" as="sourcePoint"/><mxPoint x="950" y="520" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>