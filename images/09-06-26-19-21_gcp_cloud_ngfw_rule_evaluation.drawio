<mxfile host="app.diagrams.net" modified="2026-09-06T19:21:00.000Z" agent="ChatGPT" version="24.7.17"><diagram id="cloud-ngfw" name="Page-1"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Cloud NGFW rule evaluation — why policy placement matters" style="text;html=1;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1200" height="45" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;1. Hierarchical policy&lt;/b&gt;&lt;br/&gt;Organization → folders&lt;br/&gt;allow / deny / goto_next&lt;br/&gt;Can enforce non-overridable guardrails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#d93025;fontSize=15;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="80" y="110" width="250" height="120" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;2. Regional system policy&lt;/b&gt;&lt;br/&gt;Google-managed policy stage&lt;br/&gt;Evaluated before network/classic rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f29900;fontSize=15;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="250" height="120" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;3. Global network policy&lt;/b&gt;&lt;br/&gt;Associated with the VPC&lt;br/&gt;allow / deny / goto_next / L7 intercept" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;fontSize=15;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="270" height="120" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;4. Regional network policy&lt;/b&gt;&lt;br/&gt;Associated with VPC + region&lt;br/&gt;Regional workload policy layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;fontSize=15;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1060" y="110" width="270" height="120" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;5. Classic VPC firewall rules&lt;/b&gt;&lt;br/&gt;Position depends on enforcement order&lt;br/&gt;AFTER_CLASSIC is default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#9334e6;fontSize=15;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="400" y="360" width="250" height="120" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;6. Implied actions&lt;/b&gt;&lt;br/&gt;Implied deny ingress&lt;br/&gt;Implied allow egress&lt;br/&gt;Reached only if earlier stages delegate/no match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#5f6368;fontSize=15;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="720" y="360" width="270" height="120" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;BEFORE_CLASSIC_FIREWALL&lt;/b&gt;&lt;br/&gt;Hierarchical → regional system → global network → regional network → classic VPC → implied&lt;br/&gt;Recommended when migrating to policy-first enforcement and you intentionally want network policies ahead of classic rules." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#188038;fontSize=15;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="80" y="600" width="580" height="150" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;AFTER_CLASSIC_FIREWALL (default)&lt;/b&gt;&lt;br/&gt;Hierarchical → regional system → classic VPC → global network → regional network → implied&lt;br/&gt;A classic VPC allow/deny can stop evaluation before the network firewall policy is reached." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#f29900;fontSize=15;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="760" y="600" width="580" height="150" as="geometry"/></mxCell><mxCell id="e1" value="goto_next / no match" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#f29900;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="170" as="sourcePoint"/><mxPoint x="400" y="170" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e2" value="continue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#f29900;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="170" as="sourcePoint"/><mxPoint x="720" y="170" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e3" value="goto_next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#f29900;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="990" y="170" as="sourcePoint"/><mxPoint x="1060" y="170" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e4" value="BEFORE_CLASSIC path" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#f29900;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1195" y="230" as="sourcePoint"/><mxPoint x="850" y="360" as="targetPoint"/><Array as="points"><mxPoint x="1195" y="300"/><mxPoint x="850" y="300"/></Array></mxGeometry></mxCell><mxCell id="e5" value="if no decisive match" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#f29900;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="420" as="sourcePoint"/><mxPoint x="720" y="420" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e6" value="AFTER_CLASSIC moves classic before network policies" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#5f6368;endArrow=block;endFill=1;dashed=1;dashPattern=8 7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="525" y="360" as="sourcePoint"/><mxPoint x="840" y="230" as="targetPoint"/><Array as="points"><mxPoint x="525" y="300"/><mxPoint x="840" y="300"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>