<mxfile host="app.diagrams.net" modified="2026-09-07T00:00:00.000Z" agent="ChatGPT" version="24.7.17">
  <diagram id="tls-cert-chain" name="TLS Certificate Chain">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Cloud NGFW Enterprise TLS Inspection — Certificate and Trust Flow" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="350" y="20" width="800" height="40" as="geometry"/></mxCell>
        <mxCell id="ctrl" value="Provisioning / control plane" style="swimlane;html=1;rounded=1;startSize=32;horizontal=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1420" height="185" as="geometry"/></mxCell>
        <mxCell id="capool" value="&lt;b&gt;CA Pool (regional)&lt;/b&gt;&lt;br&gt;Root CA or subordinate CA&lt;br&gt;&lt;font size='2'&gt;No issuance-policy/name constraints&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1"><mxGeometry x="70" y="135" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="agent" value="&lt;b&gt;Network Security service agent&lt;/b&gt;&lt;br&gt;roles/privateca.certificateRequester&lt;br&gt;&lt;font size='2'&gt;Requests short-lived intermediate CA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1"><mxGeometry x="420" y="135" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="policy" value="&lt;b&gt;TLS inspection policy&lt;/b&gt;&lt;br&gt;CA pool + TLS version/ciphers&lt;br&gt;&lt;font size='2'&gt;Optional upstream trust config&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1"><mxGeometry x="810" y="135" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="assoc" value="&lt;b&gt;Endpoint association&lt;/b&gt;&lt;br&gt;VPC + zone&lt;br&gt;&lt;font size='2'&gt;References TLS policy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1"><mxGeometry x="1180" y="135" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="e1" value="signs CA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block" edge="1" parent="1" source="capool" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block" edge="1" parent="1" source="agent" target="policy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="attach" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block" edge="1" parent="1" source="policy" target="assoc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="runtime" value="Runtime TLS interception — two TLS sessions" style="swimlane;html=1;rounded=1;startSize=32;horizontal=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1420" height="540" as="geometry"/></mxCell>
        <mxCell id="client" value="&lt;b&gt;Client workload&lt;/b&gt;&lt;br&gt;10.10.1.10&lt;br&gt;&lt;font size='2'&gt;Trust store contains enterprise root&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1"><mxGeometry x="80" y="410" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="ngfw" value="&lt;b&gt;Cloud NGFW firewall endpoint&lt;/b&gt;&lt;br&gt;1. Receives ClientHello / SNI&lt;br&gt;2. Mints leaf cert for requested server name&lt;br&gt;3. Terminates client-side TLS&lt;br&gt;4. Inspects plaintext, then opens upstream TLS" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1"><mxGeometry x="535" y="385" width="390" height="170" as="geometry"/></mxCell>
        <mxCell id="server" value="&lt;b&gt;Destination server&lt;/b&gt;&lt;br&gt;www.example.com:443&lt;br&gt;&lt;font size='2'&gt;Presents real public/private cert&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1"><mxGeometry x="1180" y="410" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="intca" value="&lt;b&gt;Short-lived intermediate CA&lt;/b&gt;&lt;br&gt;Generated by Cloud NGFW&lt;br&gt;&lt;font size='2'&gt;Signed by CA pool; refreshed periodically&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1"><mxGeometry x="535" y="625" width="390" height="120" as="geometry"/></mxCell>
        <mxCell id="trust" value="&lt;b&gt;Optional upstream trust config&lt;/b&gt;&lt;br&gt;Public CAs and/or private trust anchors&lt;br&gt;&lt;font size='2'&gt;Controls which server cert chains are trusted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1"><mxGeometry x="1030" y="625" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="e4" value="A. Client TLS session&#10;Leaf cert signed by NGFW intermediate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block" edge="1" parent="1" source="client" target="ngfw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="B. Upstream TLS session&#10;NGFW validates real server certificate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block" edge="1" parent="1" source="ngfw" target="server"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="signs dynamic leaf cert" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block" edge="1" parent="1" source="intca" target="ngfw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="trust decision for upstream server" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block" edge="1" parent="1" source="trust" target="ngfw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="chain" value="&lt;b&gt;Certificate chain seen by the client&lt;/b&gt;&lt;br&gt;Dynamic leaf: CN/SAN = requested destination → Cloud NGFW short-lived intermediate CA → your trusted root/subordinate chain" style="text;html=1;align=left;verticalAlign=middle;fontSize=16" vertex="1" parent="1"><mxGeometry x="80" y="770" width="1280" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>