<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q1" value="Only HTTP(S) application protection?" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#fff2cc;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="100" width="600" height="80" as="geometry"/></mxCell><mxCell id="l7" value="Use L7 ingress/WAF&#xa;AWS WAF • Azure Front Door/AppGW • GCP Cloud Armor" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1040" y="235" width="500" height="110" as="geometry"/></mxCell><mxCell id="q2" value="Must the firewall be transparent to workloads?" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#dae8fc;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="240" width="430" height="90" as="geometry"/></mxCell><mxCell id="trans" value="Transparent service insertion&#xa;AWS GWLB • Azure GWLB • GCP PBR→ILB" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#e1d5e7;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="500" height="110" as="geometry"/></mxCell><mxCell id="q3" value="Need BGP-driven routed NVA failover?" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#dae8fc;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="610" y="420" width="430" height="90" as="geometry"/></mxCell><mxCell id="bgp" value="Dynamic routed NVA&#xa;AWS VPC Route Server • Azure Route Server" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#f8cecc;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1080" y="420" width="470" height="110" as="geometry"/></mxCell><mxCell id="q4" value="Many spokes/branches need central policy?" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#dae