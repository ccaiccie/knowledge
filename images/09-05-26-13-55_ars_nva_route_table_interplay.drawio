<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="ars2" name="Route Table Interplay"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Route Tables, BGP Routes, and Dynamic Service Insertion" style="text;html=1;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="760" height="40" as="geometry"/></mxCell><mxCell id="a" value="&lt;b&gt;1. Longest prefix match&lt;/b&gt;&lt;br&gt;Most-specific route first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="280" height="100" as="geometry"/></mxCell><mxCell id="b" value="&lt;b&gt;2. Route source rules&lt;/b&gt;&lt;br&gt;System / UDR / BGP precedence&lt;br&gt;Same-VNet caveat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="280" height="120" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;3. Effective next hop&lt;/b&gt;&lt;br&gt;NVA / gateway / peering / Internet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="70" y="480" width="280" height="100" as="geometry"/></mxCell><mxCell id="d" value="&lt;b&gt;ARS+BGP sweet spot&lt;/b&gt;&lt;br&gt;Cross-VNet inspection&lt;br&gt;Dynamic 0/0&lt;br&gt;Branch prefixes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;" vertex="1" parent="1"><mxGeometry x="520" y="150" width="300" height="150" as="geometry"/></mxCell><mxCell id="e" value="&lt;b&gt;UDR still important&lt;/b&gt;&lt;br&gt;Same-VNet inspection&lt;br&gt;Exceptions / propagation control&lt;br&gt;Private Endpoint routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#f59e0b;" vertex="1" parent="1"><mxGeometry x="520" y="390" width="300" height="150" as="geometry"/></mxCell><mxCell id="f" value="&lt;b&gt;Verify&lt;/b&gt;&lt;br&gt;NIC Effective routes&lt;br