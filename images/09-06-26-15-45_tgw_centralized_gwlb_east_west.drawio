<mxfile host="app.diagrams.net" modified="2026-09-06T22:45:00.000Z" agent="ChatGPT"><diagram id="ew" name="East-West"><mxGraphModel dx="1900" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageWidth="1900" pageHeight="1050"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="East-West — Spoke A → TGW → Central Inspection VPC → TGW → Spoke B" style="text;html=1;fontSize=28;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="a" value="Spoke A&#xa;EC2-A 10.10.10.10&#xa;RT-A-App: 10.20.0.0/16 → tgw-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f59e0b;strokeWidth=3;fontSize=16" vertex="1" parent="1"><mxGeometry x="40" y="130" width="300" height="130" as="geometry"/></mxCell><mxCell id="tgw1" value="TGW-RT-SPOKES&#xa;10.20.0.0/16 → att-Inspection&#xa;10.10.0.0/16 → att-Inspection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=3;fontFamily=Courier New;fontSize=14" vertex="1" parent="1"><mxGeometry x="430" y="130" width="330" height="130" as="geometry"/></mxCell><mxCell id="tgws" value="Inspection TGW subnet AZ-a&#xa;10.255.200.0/28&#xa;RT-Insp-TGW-a:&#xa;10.20.0.0/16 → vpce-gwlb-a&#xa;10.10.0.0/16 → vpce-gwlb-a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#64748b;strokeWidth=2;fontFamily=Courier New;fontSize=14" vertex="1" parent="1"><mxGeometry x="850" y="100" width="350" height="180" as="geometry"/></mxCell><mxCell id="g" value="GWLBE-a&#xa;10.255.100.0/28&#xa;→ GWLB → NGFW fleet → same GWLBE&#xa;RT-GWLBE-a: 10.0.0.0/8 → tgw-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=3;fontFamily=Courier New;fontSize=14" vertex="1" parent="1"><mxGeometry x="1280" y="100" width="360" height="180" as="geometry"/></mxCell><mxCell id="tgw2" value="TGW-RT-INSPECTION&#xa;10.20.0.0/16 → att-Spoke-B&#xa;10.10.0.0/16 → att-Spoke-A&#xa;Associated with att-Inspection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=3;fontFamily=Courier New;fontSize=14" vertex="1" parent="1"><mxGeometry x="850" y="380" width="350" height="150" as="geometry"/></mxCell><mxCell id="b" value="Spoke B&#xa;TGW subnet → local routing&#xa;EC2-B 10.20.10.20&#xa;RT-B-App: 10.10.0.0/16 → tgw-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f59e0b;strokeWidth=3;fontSize=16" vertex="1" parent="1"><mxGeometry x="430" y="390" width="330" height="140" as="geometry"/></mxCell><mxCell id="ap" value="APPLIANCE MODE on att-Inspection&#xa;&#xa;Forward flow pins to one Inspection-VPC attachment ENI/AZ.&#xa;Reverse flow uses the same Inspection-VPC attachment ENI/AZ for the life of the flow.&#xa;Required for stateful east-west inspection across VPC attachments." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=3;fontSize=15;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="1280" y="390" width="500" height="210" as="geometry"/></mxCell><mxCell id="rt" value="Forward packet 10.10.10.10:49152 → 10.20.10.20:443&#xa;&#xa;1 Spoke A subnet RT → TGW&#xa;2 TGW-RT-SPOKES → Inspection attachment&#xa;3 Inspection TGW-subnet RT → GWLBE-a&#xa;4 GWLBE → GWLB → NGFW → GWLBE&#xa;5 GWLBE-subnet RT → TGW&#xa;6 TGW-RT-INSPECTION → Spoke B&#xa;7 Spoke B local route → EC2-B&#xa;&#xa;Return reverses the same inspection VPC AZ because appliance mode is enabled." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontFamily=Courier New;fontSize=14;align=left;verticalAlign=top;spacing=12" vertex="1" parent="1"><mxGeometry x="80" y="650" width="1660" height="270" as="geometry"/></mxCell><mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="a" target="tgw1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="tgw1" target="tgws"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#dc2626;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="tgws" target="g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="g" target="tgw2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1460" y="330"/><mxPoint x="1025" y="330"/></Array></mxGeometry></mxCell><mxCell id="e5" value="6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1" edge="1" parent="1" source="tgw2" target="b"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>