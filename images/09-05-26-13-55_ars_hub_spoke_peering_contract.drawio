<mxfile host="app.diagrams.net" modified="2026-09-05T22:30:00.000Z" agent="ChatGPT">
  <diagram id="peering-contract" name="Hub-Spoke Peering">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="How the Spoke Is Tied to the Hub Route Server" style="text;html=1;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="hub" value="&lt;b&gt;HUB VNet — 10.0.0.0/16&lt;/b&gt;&lt;br&gt;RouteServerSubnet 10.0.1.0/26&lt;br&gt;Azure Route Server — ASN 65515&lt;br&gt;NVA subnet 10.0.2.0/24&lt;br&gt;NVA 10.0.2.4 — ASN 65001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="500" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="hubpeer" value="&lt;b&gt;Hub → Spoke peering&lt;/b&gt;&lt;br&gt;Allow gateway or Route Server in HUB to forward traffic to SPOKE = Enabled&lt;br&gt;Allow forwarded traffic = Enabled when NVA transit requires it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="110" y="430" width="440" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="spoke" value="&lt;b&gt;SPOKE VNet — 10.20.0.0/16&lt;/b&gt;&lt;br&gt;Workload subnet 10.20.1.0/24&lt;br&gt;VM 10.20.1.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="920" y="150" width="500" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="spokepeer" value="&lt;b&gt;Spoke → Hub peering&lt;/b&gt;&lt;br&gt;Use the remote virtual network's gateway or Route Server = Enabled&lt;br&gt;This opts the spoke into the hub Route Server route distribution." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="950" y="430" width="440" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="flow" value="&lt;b&gt;Result&lt;/b&gt;&lt;br&gt;NVA BGP UPDATE → Route Server → Azure SDN → Spoke NIC effective route&lt;br&gt;Packet path: Spoke VM → VNet peering → NVA → destination" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="320" y="650" width="860" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="VNet peering" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="hub" target="spoke">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="Route Server usage contract" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;dashed=1;" edge="1" parent="1" source="hubpeer" target="spokepeer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
