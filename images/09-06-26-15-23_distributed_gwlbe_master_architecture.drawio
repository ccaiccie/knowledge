<mxCell id="gwlbea" value="GWLBE-A-a&#xa;10.10.100.0/28&#xa;vpce-gwlb-a" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#dc2626;strokeWidth=2.5;fillColor=#fef2f2;fontSize=16;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="55" y="300" width="225" height="105" as="geometry"/></mxCell>
<mxCell id="gwlbeb" value="GWLBE-A-b&#xa;10.10.100.16/28&#xa;vpce-gwlb-b" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#dc2626;strokeWidth=2.5;fillColor=#fef2f2;fontSize=16;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="320" y="300" width="225" height="105" as="geometry"/></mxCell>
<mxCell id="tgwa" value="TGW attach AZ-a&#xa;10.10.200.0/28" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#ffffff;fontSize=16;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="55" y="440" width="225" height="90" as="geometry"/></mxCell>
<mxCell id="tgwb" value="TGW attach AZ-b&#xa;10.10.200.16/28" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#ffffff;fontSize=16;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="320" y="440" width="225" height="90" as="geometry"/></mxCell>
<mxCell id="rtA" value="Key Spoke A VPC route tables&#xa;&#xa;RT-A-App-a (10.10.10.0/24)&#xa;10.20.0.0/16 → vpce-gwlb-a (east-west)&#xa;172.16.0.0/16 → vpce-gwlb-a (hybrid)&#xa;0.0.0.0/0 → vpce-gwlb-a (internet egress)&#xa;&#xa;RT-A-GWLBE-a (10.10.100.0/28)&#xa;10.20.0.0/16 → tgw-1&#xa;172.16.0.0/16 → tgw-1&#xa;0.0.0.0/0 → nat-a [internet variant]&#xa;&#xa;RT-A-TGW-a (10.10.200.0/28)&#xa;10.10.10.0/24 → vpce-gwlb-a (inbound enforcement)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=14;fontFamily=Courier New;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="55" y="565" width="490" height="340" as="geometry"/></mxCell>
<mxCell id="secvpc" value="Central Security VPC 10.255.0.0/16" style="swimlane;html=1;rounded=1;startSize=40;strokeColor=#f59e0b;strokeWidth=3;fillColor=#fff7ed;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="80" width="520" height="870" as="geometry"/></mxCell>
<mxCell id="gwlb" value="Gateway Load Balancer&#xa;Endpoint service: com.amazonaws.vpce...vpce-svc-SEC&#xa;Flow hashing → healthy NGFW target; GENEVE UDP/6081" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#dc2626;strokeWidth=2.5;fillColor=#fef2f2;fontSize=16;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="660" y="160" width="460" height="125" as="geometry"/></mxCell>
<mxCell id="fwA" value="AZ-a firewall&#xa;Subnet 10.255.10.0/24&#xa;NGFW-A 10.255.10.10&#xa;GENEVE target" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#ffffff;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="660" y="330" width="205" height="130" as="geometry"/></mxCell>
<mxCell id="fwB" value="AZ-b firewall&#xa;Subnet 10.255.20.0/24&#xa;NGFW-B 10.255.20.10&#xa;GENEVE target" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#ffffff;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="915" y="330" width="205" height="130" as="geometry"/></mxCell>
<mxCell id="policy" value="Central policy / state&#xa;&#xa;• Central GWLB service shared to workload accounts/VPCs&#xa;• GWLBE is the distributed route target; not a proxy/NAT&#xa;• Original 5-tuple remains visible to the NGFW&#xa;• GWLB encapsulates only between GWLB and appliance&#xa;• Endpoint routing determines where allowed traffic resumes&#xa;• Build one endpoint per required AZ to avoid cross-AZ paths" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="660" y="520" width="460" height="250" as="geometry"/></mxCell>
<mxCell id="ext" value="AWS Transit / External Domains" style="swimlane;html=1;rounded=1;startSize=40;strokeColor=#f59e0b;strokeWidth=3;fillColor=#fff7ed;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1210" y="80" width="560" height="870" as="geometry"/></mxCell>
<mxCell id="tgw" value="AWS Transit Gateway tgw-1&#xa;RT-Spoke: 10.20.0.0/16 → att-Spoke-B&#xa;RT-Spoke: 172.16.0.0/16 → att-DXGW/VPN&#xa;RT-Hybrid: 10.10.0.0/16 → att-Spoke-A&#xa;RT-Hybrid: 10.20.0.0/16 → att-Spoke-B" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#ffffff;fontSize=14;fontFamily=Courier New;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1240" y="155" width="500" height="160" as="geometry"/></mxCell>
<mxCell id="dx" value="Direct Connect&#xa;Transit VIF&#xa;→ Direct Connect gateway&#xa;→ TGW DXGW attachment&#xa;BGP: 172.16.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#ffffff;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1240" y="355" width="240" height="170" as="geometry"/></mxCell>
<mxCell id="vpn" value="Site-to-Site VPN&#xa;2 IPsec tunnels&#xa;BGP to TGW attachment&#xa;Backup or primary&#xa;172.16.0.0/16 learned" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#ffffff;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1500" y="355" width="240" height="170" as="geometry"/></mxCell>
<mxCell id="onprem" value="On-premises 172.16.0.0/16&#xa;DC routers advertise prefixes via Transit VIF and/or VPN BGP&#xa;TGW normally prefers equal-prefix DXGW propagation over VPN propagation" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#ffffff;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1240" y="570" width="500" height="120" as="geometry"/></mxCell>
<mxCell id="internet" value="Internet&#xa;Per-VPC IGW + NAT Gateway for distributed egress&#xa;IGW edge route table → GWLBE for public inbound&#xa;NAT-public subnet return route → GWLBE for symmetric egress" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=2;fillColor=#ffffff;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1240" y="735" width="500" height="150" as="geometry"/></mxCell>
<mxCell id="e1" value="service insertion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1;fontSize=14;" edge="1" parent="1" source="appa" target="gwlb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="210"/><mxPoint x="620" y="225"/></Array></mxGeometry></mxCell>
<mxCell id="e2" value="inspected packet → TGW" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=4;endArrow=block;endFill=1;fontSize=14;" edge="1" parent="1" source="tgwa" target="tgw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="485"/><mxPoint x="1210" y="240"/></Array></mxGeometry></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="dx" target="onprem"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="vpn" target="onprem"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="note" value="Enforcement principle: traffic is forced through a local GWLBE by the route table at the side where it enters or leaves the workload VPC. Hybrid inbound uses the TGW-attachment subnet RT → GWLBE; workload outbound uses the workload subnet RT → GWLBE; Internet inbound uses the IGW edge RT → GWLBE. The GWLBE subnet RT then sends the permitted packet onward to TGW, NAT/IGW, or the local workload subnet." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#f8fafc;fontSize=15;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="1690" height="130" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>