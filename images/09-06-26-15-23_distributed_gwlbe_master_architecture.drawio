<mxCell id="title" value="Distributed GWLBE + Centralized Third-Party Firewall Fleet — Master Routing Architecture" style="text;html=1;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1500" height="45" as="geometry"/></mxCell>
