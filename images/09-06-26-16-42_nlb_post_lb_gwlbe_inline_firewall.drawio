<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Client&#xa;203.0.113.8:44000" style="rounded=1;fillColor=#e8f0fe;strokeColor=#4285f4" vertex="1" parent="1"><mxGeometry x="40" y="170" width="180" height="120" as="geometry"/></mxCell><mxCell id="3" value="Network Load Balancer&#xa;TCP/TLS supported pattern&#xa;Target type = ip&#xa;preserve_client_ip = false" style="rounded=1;fillColor=#fde7f3;strokeColor=#d13212" vertex="1" parent="1"><mxGeometry x="300" y="140" width="260" height="180" as="geometry"/></mxCell><mxCell id="4" value="GWLBE — per AZ&#xa;Dedicated inspection subnet&#xa;More-specific route target" style="rounded=1;fillColor=#e6f4ea;strokeColor=#1e8e3e" vertex="1" parent="1"><mxGeometry x="650" y="140" width="230" height="180" as="geometry"/></mxCell><mxCell id="5" value="GWLB + NGFW&#xa;GENEVE UDP/6081&#xa;Firewall sees NLB node source IP" style="rounded=1;fillColor=#f3e8fd;strokeColor=#8e44ad" vertex="1" parent="1"><mxGeometry x="970" y="140" width="250" height="180" as="geometry"/></mxCell><mxCell id="6" value="Backend IP Targets&#xa;10.1.20.21:443&#xa;10.1.20.22:443&#xa;Return route → GWLBE" style="rounded=1;fillColor=#e8f5e9;strokeColor=#34a853" vertex="1" parent="1"><mxGeometry x="1310" y="140" width="240" height="180" as="geometry"/></mxCell><mxCell id="7" value="Critical constraints&#xa;NLB instance-target traffic does not follow required route-table steering.&#xa;Client-IP preservation is unsupported through GWLBE between NLB and target.&#xa;UDP/TCP_UDP/QUIC/TCP_QUIC are not equivalent to the TCP/TLS pattern.&#xa;Proxy Protocol v2 carries metadata but does not restore the routed L3 source." style="rounded=1;fillColor=#fff8e1;strokeColor=#f9ab00" vertex="1" parent="1"><mxGeometry x="300" y="500" width="1250" height="220" as="geometry"/></mxCell><mxCell id="8" value="1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1473e6;strokeWidth=3;endArrow=block" edge