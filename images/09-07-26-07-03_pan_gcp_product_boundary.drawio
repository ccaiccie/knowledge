<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Palo Alto Networks firewalling in GCP — product boundary" style="text;html=1;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1400" height="50" as="geometry"/></mxCell><mxCell id="g" value="&lt;b&gt;Google Cloud NGFW Enterprise&lt;/b&gt;&lt;br/&gt;Google-managed firewall service&lt;br/&gt;Distributed in Google VPC fabric&lt;br/&gt;Palo Alto-powered threat prevention&lt;br/&gt;Google firewall policies/security profiles&lt;br/&gt;No customer PAN-OS VM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="430" height="250" as="geometry"/></mxCell><mxCell id="p" value="&lt;b&gt;Palo Alto VM-Series on GCP&lt;/b&gt;&lt;br/&gt;Customer-deployed PAN-OS NGFW VMs&lt;br/&gt;PAN-OS zones, VR, Security/NAT policy&lt;br/&gt;PAYG or BYOL licensing&lt;br/&gt;Panorama / supported Strata management&lt;br/&gt;Requires traffic steering/service insertion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#d93025;fontSize=15;" vertex="1" parent="1"><mxGeometry x="585" y="130" width="430" height="250" as="geometry"/></mxCell><mxCell id="n" value="&lt;b&gt;Google Cloud NSI + VM-Series&lt;/b&gt;&lt;br/&gt;Google NSI intercepts selected packets&lt;br/&gt;GENEVE carries original packet + metadata&lt;br/&gt;VM-Series inspects and reinjects or drops&lt;br/&gt;Consumer VPC keeps normal routes&lt;br/&gt;Producer/consumer service model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#188038;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1110" y="130" width="430" height="250" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;Palo Alto Cloud NGFW product family&lt;/b&gt;&lt;br/&gt;Palo Alto documents Cloud NGFW for AWS and Azure.&lt;br/&gt;Do not treat that name as a separate GCP product." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f29900;fontSize=15;" vertex="1" parent="1"><mxGeometry x="260" y="520" width="480" height="170" as="geometry"/></mxCell><mxCell id="d" value="&lt;b&gt;Which GCP design should you use?&lt;/b&gt;&lt;br/&gt;Google-managed → Cloud NGFW Enterprise&lt;br/&gt;PAN-OS/App-ID → VM-Series&lt;br/&gt;Route-transparent VM-Series → NSI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#9334e6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="860" y="520" width="500" height="170" as="geometry"/></mxCell><mxCell id="e1" value="different data plane" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=4;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="255" as="sourcePoint"/><mxPoint x="585" y="255" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" value="modern insertion" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#188038;strokeWidth=4;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1015" y="255" as="sourcePoint"/><mxPoint x="1110" y="255" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>