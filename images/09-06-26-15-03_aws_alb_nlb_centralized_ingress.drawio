<mxfile host="app.diagrams.net"><diagram id="ingress" name="Centralized Ingress ALB NLB"><mxGraphModel dx="1200" dy="760" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="internet" value="Internet clients" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16" vertex="1" parent="1"><mxGeometry x="60" y="330" width="170" height="65" as="geometry"/></mxCell><mxCell id="edge" value="Optional CloudFront + AWS WAF&#xa;Layer-7 filtering / TLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14" vertex="1" parent="1"><mxGeometry x="280" y="315" width="230" height="95" as="geometry"/></mxCell><mxCell id="ingvpc" value="Centralized Ingress VPC" style="swimlane;horizontal=0;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16" vertex="1" parent="1"><mxGeometry x="560" y="150" width="640" height="520" as="geometry"/></mxCell><mxCell id="igw" value="Internet Gateway&#xa;ingress route table → firewall endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14" vertex="1" parent="ingvpc"><mxGeometry x="55" y="80" width="220" height="85" as="geometry"/></mxCell><mxCell id="fw" value="AWS Network Firewall endpoint&#xa;or GWLBE → GWLB → NGFW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14" vertex="1" parent="ingvpc"><mxGeometry x="330" y="80" width="250" height="85" as="geometry"/></mxCell><mxCell id="alb" value="Internet-facing ALB&#xa;HTTP/HTTPS reverse proxy&#xa;L7 routing + TLS termination" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14" vertex="1" parent="ingvpc"><mxGeometry x="70" y="255" width="220" height="100" as="geometry"/></mxCell><mxCell id="nlb" value="Internet-facing NLB&#xa;TCP/UDP/TLS, static IPs/EIPs&#xa;can preserve source IP depending on target mode" style="rounded=1;whiteSpace=wr