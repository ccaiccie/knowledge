<mxCell id="untrust" value="UNTRUST&#xa;ethernet1/2&#xa;NAT Gateway / IGW&#xa;Internet egress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#8e24aa;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1560" y="225" width="250" height="130" as="geometry"/></mxCell>
