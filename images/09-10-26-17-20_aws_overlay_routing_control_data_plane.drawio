<mxCell id="title" value="Palo Alto VM-Series Overlay Routing with AWS GWLB — DMZ Separation" style="text;html=1;align=center;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="1100" height="50" as="geometry"/></mxCell>
