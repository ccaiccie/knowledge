<mxfile host="app.diagrams.net">
<diagram name="Detailed DMZ Overlay Architecture">
<mxGraphModel page="1" pageWidth="1900" pageHeight="1180" grid="1" gridSize="10">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Palo Alto VM-Series Overlay Routing with AWS GWLB — DMZ Separation" style="text;html=1;align=center;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="1100" height="50" as="geometry"/></mxCell>

<mxCell id="internet" value="Internet&#xa;198.51.100.25" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=3;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="165" width="210" height="120" as="geometry"/></mxCell>

<mxCell id="dmzvpc" value="DMZ VPC — 10.10.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#fb8c00;strokeWidth=4;fontSize=23;fontStyle=1;verticalAlign=top;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="285" y="105" width="540" height="770" as="geometry"/></mxCell>
<mxCell id="igw" value="Internet Gateway&#xa;IGW gateway RT&#xa;10.10.10.0/24 → vpce-dmz-a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#ef6c00;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="175" width="200" height="105" as="geometry"/></mxCell>
<mxCell id="gwlbe" value="GWLBE-DMZ-A&#xa;vpce-dmz-a&#xa;consumer endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd180;strokeColor=#ef6c00;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="585" y="175" width="195" height="105" as="geometry"/></mxCell>
<mxCell id="app" value="DMZ ALB / Public Application Subnets&#xa;ALB: 10.10.10.0/24&#xa;App: 10.10.20.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#fb8c00;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="365" width="450" height="118" as="geometry"/></mxCell>
<mxCell id="dmzrt" value="DMZ subnet route table&#xa;&#xa;10.10.0.0/16 → local&#xa;0.0.0.0/0 → vpce-dmz-a&#xa;&#xa;AWS route to GWLBE causes initial inspection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f9a825;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="555" width="450" height="160" as="geometry"/></mxCell>

<mxCell id="secvpc" value="Security VPC — 10.100.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=4;fontSize=23;fontStyle=1;verticalAlign=top;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="875" y="105" width="615" height="770" as="geometry"/></mxCell>
<mxCell id="gwlb" value="AWS Gateway Load Balancer&#xa;Endpoint service / appliance load balancing&#xa;GENEVE UDP/6081" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="175" width="500" height="100" as="geometry"/></mxCell>
<mxCell id="fw" value="Palo Alto VM-Series&#xa;&#xa;vpce-dmz-* → e1/1.10 → DMZ&#xa;vpce-trust-* → e1/1.20 → TRUST&#xa;&#xa;PAN-OS inner-header L3 lookup&#xa;Stay on GWLB path OR decapsulate and route natively" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=3;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="940" y="335" width="480" height="380" as="geometry"/></mxCell>

<mxCell id="egress" value="Routed Egress Domains" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e24aa;strokeWidth=4;fontSize=23;fontStyle=1;verticalAlign=top;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="1535" y="105" width="325" height="770" as="geometry"/></mxCell>
<mxCell id="untrust" value="UNTRUST&#xa;ethernet1/2&#xa;NAT Gateway / IGW&#xa;Internet egress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#8e24aa;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1580" y="225" width="235" height="130" as="geometry"/></mxCell>
<mxCell id="transit" value="TRANSIT / TRUST&#xa;ethernet1/3&#xa;TGW / internal VPCs&#xa;On-prem / shared services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1580" y="475" width="235" height="150" as="geometry"/></mxCell>

<mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1565c0;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="internet" target="igw"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="2 route to vpce" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1565c0;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="igw" target="gwlbe"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="3 AWS PrivateLink" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1565c0;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="gwlbe" target="gwlb"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="4 GENEVE" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1565c0;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="gwlb" target="fw"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="5A Internet destination&#xa;decapsulate → e1/2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8e24aa;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="fw" target="untrust"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="5B Internal destination&#xa;native L3 exit" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2e7d32;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="fw" target="transit"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="same-overlay path&#xa;re-encapsulate → GWLB/GWLBE" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d84315;strokeWidth=4;endArrow=block;dashed=1;" edge="1" parent="1" source="fw" target="gwlbe"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="service-chain continuation" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#fb8c00;strokeWidth=3;endArrow=block;dashed=1;" edge="1" parent="1" source="gwlbe" target="app"><mxGeometry relative="1" as="geometry"/></mxCell>

<mxCell id="note" value="HOW TO READ THIS DESIGN&#xa;&#xa;1. AWS route tables steer selected DMZ traffic to GWLBE-DMZ.&#xa;2. Palo Alto maps the VPC endpoint ID to a subinterface/security zone.&#xa;3. PAN-OS performs the route lookup on the original inner destination.&#xa;4. The packet either remains on the GWLB service path or is decapsulated and sent through a native L3 interface.&#xa;5. Any direct AWS route around GWLBE bypasses this enforcement path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#455a64;fontSize=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="65" y="930" width="1770" height="185" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>