<mxCell id="rt" value="DMZ subnet route table&#xa;10.10.0.0/16 → local&#xa;0.0.0.0/0 → vpce-dmz-a&#xa;AWS route causes initial interception" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f9a825;fontSize=16;" vertex="1" parent="1"><mxGeometry x="300" y="630" width="470" height="150" as="geometry"/></mxCell>

