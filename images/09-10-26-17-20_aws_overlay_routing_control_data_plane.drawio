<mxCell id="e2" value="2 route → vpce" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#1565c0;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="igw" target="gwlbe"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="3 AWS PrivateLink" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#1565c0;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="gwlbe" target="gwlb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="245"/><mxPoint x="875" y="350"/><mxPoint x="1165" y="350"/></Array></mxGeometry></mxCell>
<mxCell id="e4" value="4 GENEVE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#1565c0;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="gwlb" target="fw"><mxGeometry relative="1" as="geometry"/></mxCell>

<mxCell id="e5" value="5A Internet destination&#xa;decapsulate → e1/2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#7b1fa2;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="fw" target="untrust"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1450" y="610"/><mxPoint x="1490" y="610"/><mxPoint x="1490" y="290"/></Array></mxGeometry></mxCell>
<mxCell id="e6" value="5B Internal destination" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#2e7d32;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="fw" target="transit"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1460" y="640"/><mxPoint x="1500" y="600"/></Array></mxGeometry></mxCell>

