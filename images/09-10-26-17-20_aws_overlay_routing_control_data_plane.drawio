<mxCell id="e8" value="service-chain continuation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#fb8c00;strokeWidth=3;endArrow=block;dashed=1;" edge="1" parent="1" source="gwlbe" target="app"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="675" y="340"/><mxPoint x="645" y="370"/><mxPoint x="535" y="370"/></Array></mxGeometry></mxCell>

<mxCell id="note" value="HOW TO TRACE THE PACKET&#xa;&#xa;Blue = AWS/GWLB ingress lane. Orange = same-overlay GWLB return lane. Purple = native UNTRUST exit. Green = native TRANSIT/TRUST exit.&#xa;&#xa;Rounded connectors use waypoints to route around components instead of crossing through them." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#455a64;fontSize=16;" vertex="1" parent="1"><mxGeometry x="65" y="920" width="1770" height="195" as="geometry"/></mxCell>
